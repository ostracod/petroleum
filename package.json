        }
    },
    "scripts": {
        "build": "tsc",
        "lint": "eslint .",
        "prepack": "rm -rf dist && tsc"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": ">=22.0.0",
        "eslint": "^10.12.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1"
    }
}
