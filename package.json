        "metaprogramming",
        "interpreter",
        "coroutines",
        "petroleum"
    ],
    "author": {
        "name": "Jack Eisenmann",
        "url": "https://github.com/ostracod"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostracod/petroleum.git"
    },
    "homepage": "https://github.com/ostracod/petroleum",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "files": [
        "dist"
    ],
    "bin": {
