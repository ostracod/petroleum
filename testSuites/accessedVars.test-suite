>>> testCase "ACCESSED_VARS method with shadowed variable"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode, @varNames, @getExpr]]
WORK_VAR @myVar = ("outer")
RUN {
    WORK_VAR @myVar = ("inner")
    capture "myStmt" (myVar)
}
WORK_VAR @innerScope = (SCOPE(MEMBER(capturedCode, "myStmt")))
WORK_VAR @outerScope = (MEMBER(innerScope, #PARENT))
COMMENT "The expression refers to the inner variable, which is not visible in the outer scope."
PRINT(varNames(getExpr("myStmt", 0), outerScope))
WORK_VAR @accessedVars = (CALL_METHOD(getExpr("myStmt", 0), #ACCESSED_VARS, LIST (innerScope)))
PRINT(KEYS(accessedVars))
PRINT(EQUAL(MEMBER(accessedVars, "myVar"), FIND_VAR(innerScope, "myVar")))
>>> expectPrint
LIST ()
LIST ("myVar")
1
