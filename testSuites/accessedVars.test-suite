>>> commonFile ~/targetPackage/testUtils.petrol
PREP_VAR @capturedCode = <MAP [FIELDS []]>
COMMENT "Usage: capture \"name\" $comps"
COMMENT "Stores the invocation statement in `capturedCode` without prepping child workers."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @nameComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            SET_MEMBER(capturedCode, MEMBER(nameComp, #STR), worker)
        })
    ]])
]]>
COMMENT "Usage: varNames($worker, $scope)"
COMMENT "Returns the list of variable names returned by the #ACCESSED_VARS method."
PREP_VAR @varNames = <FUNC {
    [ARGS [@worker, @scope]]
    RET (KEYS(CALL_METHOD(worker, #ACCESSED_VARS, LIST (scope))))
}>
COMMENT "Usage: getComp($name, $index)"
COMMENT "Returns a component of the invocation statement captured with $name."
PREP_VAR @getComp = <FUNC {
    [ARGS [@name, @index]]
    RET (MEMBER(MEMBER(MEMBER(capturedCode, name), #COMPS), index))
}>
COMMENT "Usage: getStmt($name, $index)"
COMMENT "Returns a statement in the statement sequence captured with $name."
PREP_VAR @getStmt = <FUNC {
    [ARGS [@name, @index]]
    RET (MEMBER(MEMBER(getComp(name, 2), #STMTS), index))
}>
COMMENT "Usage: getExpr($name, $index)"
COMMENT "Returns an expression in the expression sequence captured with $name."
PREP_VAR @getExpr = <FUNC {
    [ARGS [@name, @index]]
    RET (MEMBER(MEMBER(getComp(name, 2), #EXPRS), index))
}>
=========================
>>> testCase "ACCESSED_VARS method of literal expressions"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode, @varNames, @getExpr]]
capture "myStmt" (123, "text")
WORK_VAR @scope = (SCOPE(MEMBER(capturedCode, "myStmt")))
PRINT(CALL_METHOD(getExpr("myStmt", 0), #ACCESSED_VARS, LIST (scope)))
PRINT(CALL_METHOD(getExpr("myStmt", 1), #ACCESSED_VARS, LIST (scope)))
