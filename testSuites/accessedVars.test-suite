IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode, @varNames, @getComp, @getStmt]]
WORK_VAR @var1 = (1)
capture "myStmt" {
    PREP_FUNC @myFunc {
        PRINT(var1)
    }
}
WORK_VAR @scope = (SCOPE(MEMBER(capturedCode, "myStmt")))
COMMENT "PREP_FUNC does not create a closure, so no variables are accessed."
