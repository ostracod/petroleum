>>> testCase "ACCESSED_VARS method of procedures with default method"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode, @varNames, @getStmt]]
WORK_VAR @var1 = (1)
WORK_VAR @var2 = (2)
WORK_VAR @var3 = (3)
PREP_VAR @prepVar = <4>
capture "myStmt" {
    IF (var1) {
        PRINT(var2)
    } ELSE {
        PRINT(var3)
    }
    PREP_VAR @myFunc = <FUNC {
        [ARGS [@arg]]
        RET (ADD(arg, var2))
    }>
    TRY {
        PRINT(var3)
    } CATCH {
        [EXCEP @excep]
        PRINT(LIST (excep, var1))
    }
    PREP_VAR @myPrepVar = <prepVar>
    RUN {
        WORK_VAR @innerVar = (var2)
        PRINT(innerVar)
    }
}
WORK_VAR @scope = (SCOPE(MEMBER(capturedCode, "myStmt")))
PRINT(varNames(getStmt("myStmt", 0), scope))
WORK_VAR @funcExpr = (MEMBER(MEMBER(MEMBER(MEMBER(getStmt("myStmt", 1), #COMPS), 3), #EXPRS), 0))
COMMENT "The argument variable is declared inside the function."
PRINT(varNames(funcExpr, scope))
PRINT(varNames(getStmt("myStmt", 2), scope))
COMMENT "Prep-grade expressions are excluded even when they access visible variables."
PRINT(varNames(getStmt("myStmt", 3), scope))
PRINT(varNames(getStmt("myStmt", 4), scope))
>>> expectPrint
LIST ("var1", "var2", "var3")
LIST ("var2")
LIST ("var3", "var1")
LIST ()
LIST ("var2")
=========================
>>> testCase "ACCESSED_VARS method of custom procedure in nested worker"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode, @varNames, @getComp]]
WORK_VAR @var1 = (1)
PREP_VAR @customVars = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#ACCESSED_VARS) = (FUNC {
            [ARGS [@worker, @scope]]
            PRINT("Getting accessed vars of customVars")
            RET (MAP [FIELDS [("customVar") = (FIND_VAR(scope, "var1"))]])
        })
    ]])
]]>
capture "myStmt" {
    RUN {
        customVars
    }
}
WORK_VAR @scope = (SCOPE(MEMBER(capturedCode, "myStmt")))
PRINT(varNames(getComp("myStmt", 2), scope))
>>> expectPrint
