>>> testCase "ACCESSED_VARS method of GET procedure"
>>> setupFile ~/targetPackage/otherModule.petrol
WORK_VAR @otherVar = (1)
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode, @varNames, @getExpr]]
IMPORT <"./otherModule.petrol"> AS @otherModule
capture "myStmt" (GET <otherModule> otherVar)
WORK_VAR @getExpr1 = (getExpr("myStmt", 0))
COMMENT "The source variable is not visible in the current module."
PRINT(varNames(getExpr1, SCOPE(MEMBER(capturedCode, "myStmt"))))
WORK_VAR @otherScope = (MEMBER(otherModule, #SCOPE))
WORK_VAR @accessedVars = (CALL_METHOD(getExpr1, #ACCESSED_VARS, LIST (otherScope)))
PRINT(KEYS(accessedVars))
PRINT(EQUAL(MEMBER(accessedVars, "otherVar"), FIND_VAR(otherScope, "otherVar")))
>>> expectPrint
