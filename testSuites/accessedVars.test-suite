>>> testCase "ACCESSED_VARS method of SET procedure"
>>> setupFile ~/targetPackage/otherModule.petrol
WORK_VAR @otherVar = (1)
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode, @varNames, @getComp, @getStmt]]
IMPORT <"./otherModule.petrol"> AS @otherModule
WORK_VAR @var1 = (1)
WORK_VAR @var2 = (2)
capture "myStmt" {
    WORK_VAR @localVar = (0)
    SET var1 = (var2)
    SET localVar = (var2)
    SET <otherModule> otherVar = (var1)
}
CALL_METHOD(getComp("myStmt", 2), #PREP)
WORK_VAR @scope = (SCOPE(MEMBER(capturedCode, "myStmt")))
WORK_VAR @accessedVars = (CALL_METHOD(getStmt("myStmt", 1), #ACCESSED_VARS, LIST (scope)))
PRINT(KEYS(accessedVars))
PRINT(EQUAL(MEMBER(accessedVars, "var1"), FIND_VAR(scope, "var1")))
PRINT(varNames(getStmt("myStmt", 2), scope))
PRINT(varNames(getStmt("myStmt", 2), SCOPE(getStmt("myStmt", 2))))
COMMENT "The destination variable belongs to another module."
PRINT(varNames(getStmt("myStmt", 3), scope))
>>> expectPrint
LIST ("var1", "var2")
1
LIST ("var2")
LIST ("localVar", "var2")
LIST ("var1")
