>>> testCase "ACCESSED_VARS method of identifier expressions"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode, @varNames, @getExpr]]
WORK_VAR @myVar = (1)
capture "myStmt" (myVar, TRUE)
WORK_VAR @scope = (SCOPE(MEMBER(capturedCode, "myStmt")))
WORK_VAR @accessedVars = (CALL_METHOD(getExpr("myStmt", 0), #ACCESSED_VARS, LIST (scope)))
PRINT(KEYS(accessedVars))
PRINT(EQUAL(MEMBER(accessedVars, "myVar"), FIND_VAR(scope, "myVar")))
COMMENT "Built-in constants are visible in the global scope."
PRINT(varNames(getExpr("myStmt", 1), scope))
COMMENT "Variables which are not visible in the scope are excluded."
WORK_VAR @emptyScope = (MAP [FIELDS [(#IS_SCOPE) = (TRUE), (#VARS) = (MAP [FIELDS []])]])
PRINT(varNames(getExpr("myStmt", 0), emptyScope))
>>> expectPrint
