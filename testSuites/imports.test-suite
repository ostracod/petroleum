>>> setupFile ~/targetPackage/main.petrol
COMMENT "The #EVAL method invokes the #PREP method of the child statement sequence."
PREP_VAR @prepLater = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
        })
        (#EVAL) = (FUNC {
            [ARGS [@worker, @frame]]
            WORK_VAR @stmtsComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            CALL_METHOD(stmtsComp, #PREP)
            CALL_METHOD(stmtsComp, #EVAL, LIST (frame))
        })
    ]])
]]>
PRINT("Before import")
prepLater {
    IMPORT <"./otherModule.petrol"> [VARS [@otherVar]]
}
PRINT("This line is not reached")
