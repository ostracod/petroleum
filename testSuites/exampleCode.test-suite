>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./repeat.petrol"> [VARS [@repeat]]
WORK_VAR @outerCount = (1)
WORK_VAR @log = (LIST ())
repeat (outerCount) [1] {
    WORK_VAR @letter = ("a")
    repeat (0) [3] {
        ADD_ELEM(log, letter)
        SET letter = (CONCAT(LIST (letter, "a")))
    }
}
PRINT(log)
COMMENT "The body is not evaluated when the count is zero or less."
repeat (NEG(5)) [5] {
    PRINT("This line is not reached")
}
