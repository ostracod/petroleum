>>> testCase "SCHED procedure"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myList = (LIST ())
SCHED {
    ADD_ELEM(myList, "Scheduled")
    PRINT(myList)
}
ADD_ELEM(myList, "Main 1")
ADD_ELEM(myList, "Main 2")
PRINT("Main finished")
>>> expectPrint
Main finished
LIST ("Main 1", "Main 2", "Scheduled")
=========================
