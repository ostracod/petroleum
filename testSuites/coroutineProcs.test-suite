>>> testCase "AWAIT exception"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myMap = (MAP [FIELDS []])
WORK_VAR @alwaysTrue = (FUNC {[ARGS [@member]], RET (TRUE)})
SCHED {
    PRINT("Setting field")
    SET_MEMBER(myMap, "a", 50)
}
TRY {
    PRINT(AWAIT (myMap, "a", alwaysTrue, "Waiting for field"))
} CATCH {
    [EXCEP @excep]
    PRINT(MEMBER(excep, #EXCEP_TYPE))
    PRINT(EQUAL(MEMBER(excep, #BUNCH), myMap))
    PRINT(MEMBER(excep, #LOC))
    PRINT(EQUAL(MEMBER(excep, #COND), alwaysTrue))
    PRINT(MEMBER(excep, #MESSAGE))
    PRINT(TYPE(MEMBER(excep, #EVAL_STATE)))
    THROW (excep)
}
>>> expectPrint
#AWAIT_EXCEP
1
a
1
Waiting for field
#EVAL_STATE
Setting field
50
=========================
>>> testCase "AWAIT procedure with too few expressions"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myMap = (MAP [FIELDS []])
AWAIT (myMap, "a", FUNC {[ARGS [@member]], RET (TRUE)})
>>> expectError type: #SYNTAX_ERROR message: "Expected 4 expressions in sequence." lineNumber: 2
