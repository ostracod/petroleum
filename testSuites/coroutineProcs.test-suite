>>> testCase "SPIN procedure"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myList = (LIST ())
SCHED {
    ADD_ELEM(myList, "Scheduled")
}
SPIN (FUNC {
    RET (TRUE)
}, "Not waiting")
ADD_ELEM(myList, "Main")
SPIN (FUNC {
    RET (EQUAL(LEN(myList), 2))
}, "Waiting for scheduled coroutine")
PRINT(myList)
>>> expectPrint
LIST ("Main", "Scheduled")
=========================
>>> testCase "SPIN procedure stuck"
>>> setupFile ~/targetPackage/main.petrol
PRINT("Before spin")
SPIN (FUNC {RET (FALSE)}, "Waiting forever")
PRINT("This line is not reached")
>>> expectPrint
Before spin
>>> expectStuck message: "Waiting forever" lineNumber: 2
=========================
>>> testCase "AWAIT procedure with present member"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myMap = (MAP [FIELDS [("a") = (10)]])
WORK_VAR @isTen = (FUNC {
    [ARGS [@member]]
    RET (EQUAL(member, 10))
})
PRINT(AWAIT (myMap, "a", isTen, "Waiting for field"))
>>> expectPrint
10
=========================
>>> testCase "AWAIT procedure with missing member"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myMap = (MAP [FIELDS []])
WORK_VAR @myList = (LIST (10))
SCHED {
    PRINT("Populating members")
    SET_MEMBER(myMap, "a", 20)
    ADD_ELEM(myList, 30)
}
WORK_VAR @alwaysTrue = (FUNC {
    [ARGS [@member]]
    RET (TRUE)
})
PRINT(AWAIT (myMap, "a", alwaysTrue, "Waiting for field"))
PRINT(AWAIT (myList, 1, alwaysTrue, "Waiting for element"))
>>> expectPrint
Populating members
20
30
=========================
>>> testCase "AWAIT procedure with condition"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myList = (LIST (0))
SCHED {
    WORK_VAR @count = (0)
    WHILE (LESS(count, 5)) {
        SET count = (ADD(count, 1))
        SET_MEMBER(myList, 0, count)
    }
}
WORK_VAR @value = (AWAIT (myList, 0, FUNC {
    [ARGS [@member]]
    RET (GREATER_EQUAL(member, 3))
}, "Waiting for element to be at least 3"))
PRINT(GREATER_EQUAL(value, 3))
>>> expectPrint
1
=========================
>>> testCase "AWAIT procedure stuck"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myMap = (MAP [FIELDS [("a") = (1)]])
WORK_VAR @isTwo = (FUNC {[ARGS [@member]], RET (EQUAL(member, 2))})
PRINT("Before await")
AWAIT (myMap, "a", isTwo, "Waiting for field to be 2")
PRINT("This line is not reached")
>>> expectPrint
