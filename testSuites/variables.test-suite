>>> testCase "Deferred prep-var value unwrapped after initialization"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @releases = <MAP [FIELDS []]>
PREP_VAR @slowVar = <RUN {
    SPIN (FUNC {
        RET (HAS_KEY(releases, "slowVar"))
    }, "Waiting for release of slowVar")
    PRINT("Initializing slowVar")
    RET (5)
}>
PREP_VAR @myList = <RUN {
    PRINT("Reading slowVar")
    COMMENT "The deferred value is stored without pausing."
    WORK_VAR @value = (slowVar)
    PRINT("Read slowVar")
    SET_MEMBER(releases, "slowVar", TRUE)
    RET (LIST (value))
}>
PRINT(myList)
>>> expectPrint
Reading slowVar
Read slowVar
Initializing slowVar
LIST (5)
