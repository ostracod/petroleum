>>> testCase "Deferred prep-var value pauses until initialization"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @releases = <MAP [FIELDS []]>
PREP_VAR @slowVar = <RUN {
    SPIN (FUNC {
        RET (HAS_KEY(releases, "slowVar"))
    }, "Waiting for release of slowVar")
    PRINT("Initializing slowVar")
    RET (5)
}>
PREP_VAR @sum = <RUN {
    PRINT("Reading slowVar")
    SET_MEMBER(releases, "reading", TRUE)
    COMMENT "ADD must know the deferred value, so evaluation pauses."
    WORK_VAR @value = (ADD(slowVar, 10))
    PRINT("Read slowVar")
    RET (value)
}>
PREP_VAR @releaser = <RUN {
    SPIN (FUNC {
        RET (HAS_KEY(releases, "reading"))
    }, "Waiting for sum to read slowVar")
    PRINT("Releasing slowVar")
    SET_MEMBER(releases, "slowVar", TRUE)
}>
PRINT(sum)
>>> expectPrint
Reading slowVar
Releasing slowVar
Initializing slowVar
Read slowVar
15
=========================
