>>> testCase "Variables visible in nested scopes"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @myPrepVar = <"prep-var">
WORK_VAR @myWorkVar = ("work-var")
RUN {
    PRINT(myPrepVar)
    PRINT(myWorkVar)
    RUN {
        WORK_VAR @innerVar = ("inner")
        IF (TRUE) {
            PRINT(myWorkVar)
            PRINT(innerVar)
        }
    }
}
>>> expectPrint
prep-var
work-var
work-var
inner
=========================
>>> testCase "Variable declared later in same scope"
>>> setupFile ~/targetPackage/main.petrol
PRINT(myVar)
WORK_VAR @myVar = (10)
PRINT(myVar)
RUN {
    PRINT(innerVar)
    WORK_VAR @innerVar = (20)
    PRINT(innerVar)
}
>>> expectPrint
NULL
10
NULL
20
=========================
>>> testCase "Out-of-scope variables"
>>> setupFile ~/targetPackage/main.petrol
PRINT("This line is not reached")
RUN {
    WORK_VAR @runVar = (1)
}
PRINT(runVar)
IF (TRUE) {
    WORK_VAR @ifVar = (2)
}
PRINT(ifVar)
RUN {
    PRINT(runVar)
}
PREP_VAR @myFunc1 = <FUNC {
    WORK_VAR @funcVar = (3)
}>
PREP_VAR @myFunc2 = <FUNC {
    RET (funcVar)
}>
>>> expectError type: #VALUE_ERROR message: "Could not find variable with name \"runVar\"." lineNumber: 5
>>> expectError type: #VALUE_ERROR message: "Could not find variable with name \"ifVar\"." lineNumber: 9
>>> expectError type: #VALUE_ERROR message: "Could not find variable with name \"runVar\"." lineNumber: 11
>>> expectError type: #VALUE_ERROR message: "Could not find variable with name \"funcVar\"." lineNumber: 17
=========================
