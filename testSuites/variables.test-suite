>>> testCase "Variable shadowing"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myVar = ("outer")
RUN {
    WORK_VAR @myVar = ("middle")
    PRINT(myVar)
    RUN {
        PREP_VAR @myVar = <"inner">
        PRINT(myVar)
    }
    PRINT(myVar)
}
PRINT(myVar)
>>> expectPrint
middle
inner
middle
outer
=========================
>>> testCase "Assigning to shadowing variable"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myVar = ("outer")
RUN {
    WORK_VAR @myVar = ("inner")
    SET myVar = ("changed inner")
    PRINT(myVar)
}
PRINT(myVar)
>>> expectPrint
changed inner
outer
=========================
>>> testCase "Shadowing variable before its declaration"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myVar = ("outer")
RUN {
    COMMENT "This refers to the inner variable, which has not been assigned yet."
    PRINT(myVar)
    WORK_VAR @myVar = ("inner")
    PRINT(myVar)
}
>>> expectPrint
NULL
inner
=========================
>>> testCase "Function argument shadowing"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @value = ("outer")
PREP_VAR @identity = <FUNC {
    [ARGS [@value]]
    RET (value)
}>
PRINT(identity("argument"))
PRINT(value)
>>> expectPrint
argument
outer
=========================
>>> testCase "Shadowing global constant"
>>> setupFile ~/targetPackage/otherModule.petrol
PREP_VAR @otherTrue = <TRUE>
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./otherModule.petrol"> [VARS [@otherTrue]]
PREP_VAR @TRUE = <"shadowed">
PRINT(TRUE)
PRINT(otherTrue)
>>> expectPrint
shadowed
1
