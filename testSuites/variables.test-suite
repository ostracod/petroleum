>>> testCase "Variables visible in nested scopes"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @myPrepVar = <"prep-var">
WORK_VAR @myWorkVar = ("work-var")
RUN {
    PRINT(myPrepVar)
    PRINT(myWorkVar)
    RUN {
        WORK_VAR @innerVar = ("inner")
        IF (TRUE) {
            PRINT(myWorkVar)
            PRINT(innerVar)
        }
    }
}
>>> expectPrint
