>>> testCase "Fields stored by PREP, GET, and SET procedures"
>>> setupFile ~/targetPackage/otherModule.petrol
PREP_VAR @otherVar = <10>
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @capturedComps = <MAP [FIELDS []]>
COMMENT "Preps the second component and stores it in `capturedComps`."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @comps = (MEMBER(worker, #COMPS))
            WORK_VAR @name = (MEMBER(MEMBER(comps, 1), #STR))
            SET_MEMBER(capturedComps, name, MEMBER(comps, 2))
            CALL_METHOD(MEMBER(comps, 2), #PREP)
        })
    ]])
]]>
IMPORT <"./otherModule.petrol"> AS @otherModule
WORK_VAR @myVar = (1)
capture "prep" (PREP <ADD(2, 3)>)
capture "get" (GET <otherModule> otherVar)
capture "set" {
    SET myVar = (2)
}
WORK_VAR @prepExpr = (MEMBER(MEMBER(MEMBER(capturedComps, "prep"), #EXPRS), 0))
PRINT(MEMBER(prepExpr, #VALUE))
WORK_VAR @getExpr = (MEMBER(MEMBER(MEMBER(capturedComps, "get"), #EXPRS), 0))
WORK_VAR @otherScope = (MEMBER(otherModule, #SCOPE))
PRINT(EQUAL(MEMBER(getExpr, #SRC_VAR), FIND_VAR(otherScope, "otherVar")))
WORK_VAR @setStmt = (MEMBER(MEMBER(MEMBER(capturedComps, "set"), #STMTS), 0))
PRINT(EQUAL(MEMBER(setStmt, #DEST_VAR), FIND_VAR(SCOPE(setStmt), "myVar")))
PRINT(MEMBER(MEMBER(setStmt, #DEST_VAR), #IDENT))
>>> expectPrint
5
1
1
myVar
=========================
