>>> testCase "Closure accesses variables assigned after function creation"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myVar1
RUN {
    WORK_VAR @myVar2
    WORK_VAR @myFunc1 = (FUNC {
        PRINT(ADD(myVar1, myVar2))
    })
    PREP_VAR @myFunc2 = <FUNC {
        PRINT(ADD(myVar1, 1))
    }>
    SET myVar1 = (10)
    SET myVar2 = (20)
    CALL(myFunc1)
    myFunc2()
}
