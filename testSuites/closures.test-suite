>>> testCase "Closures outlive enclosing scope"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @createCounter = <FUNC {
    WORK_VAR @count = (0)
    WORK_VAR @increment = (FUNC {
        SET count = (ADD(count, 1))
    })
    WORK_VAR @getCount = (FUNC {
        RET (count)
    })
    RET (LIST (increment, getCount))
}>
WORK_VAR @counter1 = (createCounter())
WORK_VAR @counter2 = (createCounter())
CALL(MEMBER(counter1, 0))
CALL(MEMBER(counter1, 0))
CALL(MEMBER(counter2, 0))
PRINT(CALL(MEMBER(counter1, 1)))
PRINT(CALL(MEMBER(counter2, 1)))
>>> expectPrint
2
1
