>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @factorial = <FUNC {
    [ARGS [@n]]
    IF (LESS_EQUAL(n, 1)) {
        RET (1)
    }
    WORK_VAR @result = (MUL(n, CALL(factorial, LIST (SUB(n, 1)))))
    RET (result)
}>
PRINT(factorial(5))
