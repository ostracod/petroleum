>>> testCase "Closure frames exclude unnecessary work-vars"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@currentFrame]]
WORK_VAR @moduleFrame = (currentFrame ())
WORK_VAR @topVar = (1)
RUN {
    WORK_VAR @usedVar = (2)
    WORK_VAR @unusedVar = (LIST ("large", "value"))
    WORK_VAR @runFrame = (currentFrame ())
    WORK_VAR @createInner = (FUNC {
        [ARGS [@usedArg, @unusedArg]]
        WORK_VAR @unusedLocal = (3)
        RET (FUNC {
            WORK_VAR @innerFrame = (currentFrame ())
            PRINT(ADD(ADD(topVar, usedVar), usedArg))
            RET (innerFrame)
        })
    })
    WORK_VAR @inner = (CALL(createInner, LIST (4, 5)))
    WORK_VAR @innerFrame = (CALL(inner))
    PRINT(KEYS(MEMBER(innerFrame, #FRAME_ENTRIES)))
    COMMENT "Pruned frame of the createInner body."
    WORK_VAR @closureFrame1 = (MEMBER(innerFrame, #PARENT))
    PRINT(KEYS(MEMBER(closureFrame1, #FRAME_ENTRIES)))
    COMMENT "Pruned frame of the RUN body."
    WORK_VAR @closureFrame2 = (MEMBER(closureFrame1, #PARENT))
    PRINT(KEYS(MEMBER(closureFrame2, #FRAME_ENTRIES)))
    PRINT(EQUAL(MEMBER(closureFrame2, #SCOPE), MEMBER(runFrame, #SCOPE)))
    PRINT(EQUAL(closureFrame2, runFrame))
    COMMENT "The closure shares frame entries with the original frame."
    WORK_VAR @runEntries = (MEMBER(runFrame, #FRAME_ENTRIES))
    WORK_VAR @closureEntries = (MEMBER(closureFrame2, #FRAME_ENTRIES))
    PRINT(EQUAL(MEMBER(closureEntries, "usedVar"), MEMBER(runEntries, "usedVar")))
    COMMENT "Module frames are not pruned."
    PRINT(EQUAL(MEMBER(closureFrame2, #PARENT), moduleFrame))
}
>>> expectPrint
7
LIST ("innerFrame")
LIST ("usedArg")
LIST ("usedVar")
1
0
1
1
