>>> testCase "Nested closures"
>>> setupFile ~/targetPackage/main.petrol
RUN {
    WORK_VAR @base = (100)
    WORK_VAR @createAdder = (FUNC {
        [ARGS [@amount]]
        COMMENT "Only the inner function accesses `base`."
        RET (FUNC {
            [ARGS [@value]]
            RET (ADD(ADD(base, amount), value))
        })
    })
    WORK_VAR @add5 = (CALL(createAdder, LIST (5)))
    WORK_VAR @add10 = (CALL(createAdder, LIST (10)))
    PRINT(CALL(add5, LIST (1)))
    PRINT(CALL(add10, LIST (2)))
    SET base = (200)
    PRINT(CALL(add5, LIST (3)))
}
>>> expectPrint
106
112
208
