>>> commonFile ~/targetPackage/testUtils.petrol
PREP_FUNC @printPackage {
    [ARGS [@pack, @indent]]
    PRINT(CONCAT(LIST (indent, MEMBER(pack, #SPECIFIER), " ", MEMBER(pack, #VER))))
    WORK_VAR @deps = (MEMBER(pack, #DEPS))
    WORK_VAR @specifiers = (KEYS(deps))
    WORK_VAR @index = (0)
    WHILE (LESS(index, LEN(specifiers))) {
        printPackage(MEMBER(deps, MEMBER(specifiers, index)), CONCAT(LIST (indent, "    ")))
        SET index = (ADD(index, 1))
    }
}
COMMENT "Usage: printPackages"
COMMENT "Prints the package of the current module, followed by the tree of resolved dependencies."
PREP_VAR @printPackages = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#EVAL) = (FUNC {
            [ARGS [@worker, @frame]]
            WORK_VAR @module = (MEMBER(SCOPE(worker), #MODULE))
            printPackage(MEMBER(module, #PACK), "")
        })
    ]])
]]>
