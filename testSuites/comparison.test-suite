>>> testCase "EQUAL function with integers"
>>> setupFile ~/targetPackage/main.petrol
PRINT(EQUAL(5, 5))
PRINT(EQUAL(5, 6))
PRINT(EQUAL(NEG(5), 5))
PRINT(EQUAL(TRUE, 1))
>>> expectPrint
1
0
0
1
=========================
>>> testCase "EQUAL function with strings"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @str1 = ("hello")
WORK_VAR @str2 = (CONCAT(LIST("hel", "lo")))
PRINT(EQUAL(str1, str2))
PRINT(EQUAL("hello", "Hello"))
PRINT(EQUAL("hello", "hello "))
PRINT(EQUAL("", ""))
>>> expectPrint
1
0
0
1
=========================
>>> testCase "EQUAL function with symbols"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @mySymbol = (SYMBOL("mySymbol"))
PRINT(EQUAL(mySymbol, mySymbol))
PRINT(EQUAL(mySymbol, SYMBOL("mySymbol")))
PRINT(EQUAL(#INT, #INT))
PRINT(EQUAL(#INT, #STR))
>>> expectPrint
