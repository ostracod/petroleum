>>> testCase "EQUAL function with lists and maps"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @list1 = (LIST(1, 2, 3))
WORK_VAR @list2 = (LIST(1, 2, 3))
WORK_VAR @list3 = (list1)
PRINT(EQUAL(list1, list3))
PRINT(EQUAL(list1, list2))
WORK_VAR @map1 = (MAP [FIELDS [("a") = (1)]])
WORK_VAR @map2 = (MAP [FIELDS [("a") = (1)]])
PRINT(EQUAL(map1, map1))
PRINT(EQUAL(map1, map2))
>>> expectPrint
1
0
1
0
=========================
