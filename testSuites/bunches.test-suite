>>> testCase "HAS_KEY function"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @mySymbol = (SYMBOL("mySymbol"))
WORK_VAR @myMap = (MAP [FIELDS [("a") = (1), (2) = (NULL), (mySymbol) = (4)]])
PRINT(HAS_KEY(myMap, "a"))
PRINT(HAS_KEY(myMap, CONCAT(LIST("", "a"))))
PRINT(HAS_KEY(myMap, "b"))
PRINT(HAS_KEY(myMap, 2))
PRINT(HAS_KEY(myMap, "2"))
PRINT(HAS_KEY(myMap, mySymbol))
PRINT(HAS_KEY(myMap, SYMBOL("mySymbol")))
DEL_FIELD(myMap, "a")
PRINT(HAS_KEY(myMap, "a"))
SET_MEMBER(myMap, "c", 5)
PRINT(HAS_KEY(myMap, "c"))
>>> expectPrint
1
1
0
1
0
1
0
0
1
