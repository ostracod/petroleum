>>> testCase "ADD_ELEM and ADD_ELEMS functions with invalid index"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @printError {
    [ARGS [@func, @args]]
    TRY {
        CALL(func, args)
    } CATCH {
        [EXCEP @excep]
        PRINT(LIST (MEMBER(excep, #ERROR_TYPE), MEMBER(excep, #MESSAGE)))
    }
}
WORK_VAR @myList = (LIST (1, 2))
printError(ADD_ELEM, LIST (myList, 3, 3))
printError(ADD_ELEM, LIST (myList, 3, NEG(1)))
printError(ADD_ELEMS, LIST (myList, LIST (3), 3))
printError(ADD_ELEMS, LIST (myList, LIST (), NEG(1)))
PRINT(myList)
>>> expectPrint
LIST (#VALUE_ERROR, "Insertion index is out of bounds.")
LIST (#VALUE_ERROR, "Insertion index is out of bounds.")
LIST (#VALUE_ERROR, "Insertion index is out of bounds.")
LIST (#VALUE_ERROR, "Insertion index is out of bounds.")
LIST (1, 2)
=========================
>>> testCase "AWAIT element shifted by ADD_ELEM"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myList = (LIST ("a", "b", "c"))
SCHED {
    PRINT("Inserting element")
    ADD_ELEM(myList, "z", 0)
}
COMMENT "The element at index 2 becomes \"b\" when \"b\" is shifted to the right."
PRINT(AWAIT (myList, 2, FUNC {
    [ARGS [@member]]
    RET (EQUAL(member, "b"))
}, "Waiting for b at index 2"))
PRINT(myList)
>>> expectPrint
Inserting element
b
LIST ("z", "a", "b", "c")
=========================
>>> testCase "AWAIT elements shifted by ADD_ELEMS"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myList = (LIST (10, 20, 30))
SCHED {
    PRINT("Inserting elements")
    ADD_ELEMS(myList, LIST (1, 2), 1)
}
COMMENT "Index 3 receives 20, and index 4 is created to hold 30."
WORK_VAR @value1 = (AWAIT (myList, 3, FUNC {
    [ARGS [@member]]
    RET (EQUAL(member, 20))
}, "Waiting for 20 at index 3"))
WORK_VAR @value2 = (DEFER_MEMBER(myList, 4, "Waiting for index 4"))
PRINT(LIST (value1, value2))
PRINT(myList)
>>> expectPrint
Inserting elements
LIST (20, 30)
LIST (10, 1, 2, 20, 30)
