>>> testCase "CONCAT function with lists"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @list1 = (LIST(10, 20))
WORK_VAR @list2 = (LIST("text"))
WORK_VAR @result = (CONCAT(LIST(list1, LIST(), list2)))
