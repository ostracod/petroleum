>>> testCase "PATH_NAME function"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <#FILE_SYSTEM> [VARS [@PATH_NAME]]
PRINT(PATH_NAME("/home/testUser/notes.txt"))
PRINT(PATH_NAME("data/subDir"))
PRINT(PATH_NAME("data/subDir/"))
PRINT(PATH_NAME("notes.txt"))
COMMENT "Trailing . and .. segments are resolved."
PRINT(PATH_NAME("data/subDir/.."))
PRINT(PATH_NAME("data/."))
PRINT(PATH_NAME("/home/testUser/.."))
COMMENT "Paths which resolve to . or a parent of . are returned normalized."
PRINT(PATH_NAME("."))
PRINT(PATH_NAME("data/.."))
PRINT(PATH_NAME(".."))
PRINT(PATH_NAME("../data/.."))
PRINT(PATH_NAME("../.."))
COMMENT "The root directory is also returned normalized."
PRINT(PATH_NAME("/"))
PRINT(PATH_NAME("/home/.."))
PRINT(PATH_NAME("//"))
