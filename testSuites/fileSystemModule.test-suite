>>> commonFile ~/targetPackage/testUtils.petrol
IMPORT <#FILE_SYSTEM> [VARS [@#FILE_SYSTEM_ERROR]]
COMMENT "Usage: tryCall($func, $args)"
COMMENT "Calls $func with $args. Prints the result, or the type of error if one is thrown."
PREP_FUNC @tryCall {
    [ARGS [@func, @args]]
    TRY {
        PRINT(CALL(func, args))
    } CATCH {
        [EXCEP @excep]
        WORK_VAR @errorType = (MEMBER(excep, #ERROR_TYPE))
        IF (EQUAL(errorType, #FILE_SYSTEM_ERROR)) {
            PRINT("File system error")
        } ELSE {
            PRINT(errorType)
        }
    }
}
