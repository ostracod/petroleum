>>> testCase "PARSE_INT function reverses STR function with base"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @values = (LIST (0, 1, NEG(1), 12345, NEG(987654321), 9223372036854775807, SUB(NEG(9223372036854775807), 1)))
WORK_VAR @bases = (LIST (2, 7, 10, 16, 36))
WORK_VAR @mismatchCount = (0)
WORK_VAR @valueIndex = (0)
WHILE (LESS(valueIndex, LEN(values))) {
    WORK_VAR @value = (MEMBER(values, valueIndex))
    WORK_VAR @baseIndex = (0)
    WHILE (LESS(baseIndex, LEN(bases))) {
        WORK_VAR @base = (MEMBER(bases, baseIndex))
        IF (NOT_EQUAL(PARSE_INT(STR(value, base), base), value)) {
            SET mismatchCount = (ADD(mismatchCount, 1))
        }
        SET baseIndex = (ADD(baseIndex, 1))
    }
    SET valueIndex = (ADD(valueIndex, 1))
}
PRINT(mismatchCount)
>>> expectPrint
0
=========================
