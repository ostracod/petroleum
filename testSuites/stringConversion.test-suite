>>> commonFile ~/targetPackage/testUtils.petrol
COMMENT "Usage: printError($func, $args)"
COMMENT "Calls $func with $args. Prints the result, or the error type and message if an error is thrown."
PREP_FUNC @printError {
    [ARGS [@func, @args]]
    TRY {
        PRINT(CALL(func, args))
    } CATCH {
        [EXCEP @excep]
        PRINT(LIST (MEMBER(excep, #ERROR_TYPE), MEMBER(excep, #MESSAGE)))
    }
}
=========================
