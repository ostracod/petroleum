>>> testCase "INIT module attribute replaces global scope"
>>> setupFile ~/targetPackage/main.petrol
[INIT {
    COMMENT "Returns the scope of the module which contains the invocation."
    PREP_VAR @getModuleScope = <MAP [FIELDS [
        (#IS_PROC) = (TRUE)
        (#METHODS) = (MAP [FIELDS [
            (#EVAL) = (FUNC {
                [ARGS [@worker, @frame]]
                WORK_VAR @node = (worker)
                WHILE (NOT(HAS_KEY(node, #MODULE_TYPE))) {
                    SET node = (MEMBER(node, #PARENT))
                }
                RET (MEMBER(node, #SCOPE))
            })
        ]])
    ]]>
    WORK_VAR @printSumVar = (MAP [FIELDS [
        (#VAR_TYPE) = (#PREP_VAR)
        (#IDENT) = ("PRINT_SUM")
        (#VALUE) = (FUNC {
            [ARGS [@num1, @num2]]
            PRINT(ADD(num1, num2))
        })
    ]])
    WORK_VAR @newScope = (MAP [FIELDS [
        (#IS_SCOPE) = (TRUE)
        (#VARS) = (MAP [FIELDS [("PRINT_SUM") = (printSumVar)]])
    ]])
    SET_MEMBER(printSumVar, #SCOPE, newScope)
    SET_MEMBER(getModuleScope (), #PARENT, newScope)
}]
PRINT_SUM(1, 2)
PRINT_SUM(10, 20)
>>> expectPrint
3
30
=========================
>>> testCase "INIT module attribute conceals built-in constants"
>>> setupFile ~/targetPackage/main.petrol
[INIT {
    PREP_VAR @getModuleScope = <MAP [FIELDS [
        (#IS_PROC) = (TRUE)
        (#METHODS) = (MAP [FIELDS [
            (#EVAL) = (FUNC {
                [ARGS [@worker, @frame]]
                WORK_VAR @node = (worker)
                WHILE (NOT(HAS_KEY(node, #MODULE_TYPE))) {
                    SET node = (MEMBER(node, #PARENT))
                }
                RET (MEMBER(node, #SCOPE))
            })
        ]])
    ]]>
    WORK_VAR @emptyScope = (MAP [FIELDS [
        (#IS_SCOPE) = (TRUE)
        (#VARS) = (MAP [FIELDS []])
    ]])
    SET_MEMBER(getModuleScope (), #PARENT, emptyScope)
}]
