>>> testCase "Custom method on procedure"
>>> setupFile ~/targetPackage/main.petrol
PREP_SYMBOL @#greet
PREP_SYMBOL @#farewell
PREP_VAR @workers = <MAP [FIELDS []]>
PREP_VAR @greeter = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @name = (MEMBER(MEMBER(MEMBER(worker, #COMPS), 1), #STR))
            SET_MEMBER(workers, name, worker)
        })
        (#greet) = (FUNC {
            [ARGS [@worker, @greeting]]
            WORK_VAR @name = (MEMBER(MEMBER(MEMBER(worker, #COMPS), 1), #STR))
            RET (CONCAT(LIST (greeting, ", ", name)))
        })
    ]])
]]>
greeter "Alice"
greeter "Bob"
PRINT(CALL_METHOD(MEMBER(workers, "Alice"), #greet, LIST ("Hello")))
PRINT(CALL_METHOD(MEMBER(workers, "Bob"), #greet, LIST ("Hi")))
COMMENT "Methods may also be added to a procedure after it is created."
SET_MEMBER(MEMBER(greeter, #METHODS), #farewell, FUNC {
    [ARGS [@worker]]
    RET (CONCAT(LIST ("Goodbye, ", MEMBER(MEMBER(MEMBER(worker, #COMPS), 1), #STR))))
})
PRINT(CALL_METHOD(MEMBER(workers, "Bob"), #farewell))
>>> expectPrint
Hello, Alice
Hi, Bob
Goodbye, Bob
=========================
>>> testCase "Custom method defined later"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode]]
PREP_SYMBOL @#double
capture "myStmt" (21)
WORK_VAR @expr = (MEMBER(MEMBER(MEMBER(MEMBER(capturedCode, "myStmt"), #COMPS), 2), #EXPRS))
SET expr = (MEMBER(expr, 0))
SCHED {
    PRINT("Defining method")
    SET_MEMBER(INT_EXPR_METHODS, #double, FUNC {
        [ARGS [@worker]]
        RET (MUL(MEMBER(worker, #INT), 2))
    })
}
PRINT("Invoking method")
PRINT(CALL_METHOD(expr, #double))
>>> expectPrint
Invoking method
Defining method
42
=========================
