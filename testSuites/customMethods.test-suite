>>> testCase "Custom method invokes PREP method first"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode]]
PREP_SYMBOL @#describe
SET_MEMBER(FUNC_INVOC_METHODS, #describe, FUNC {
    [ARGS [@worker]]
    RET (CONCAT(LIST ("Invocation of ", STR(MEMBER(worker, #INVOC)), " in ", STR(MEMBER(worker, #PHASE)))))
})
PREP_SYMBOL @#greet
PREP_VAR @greeter = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            PRINT("Prepping greeter")
        })
        (#greet) = (FUNC {
            [ARGS [@worker]]
            RET (CONCAT(LIST ("Hello in ", STR(MEMBER(worker, #PHASE)))))
        })
    ]])
]]>
capture "funcStmt" (ADD(1, 2))
capture "procStmt" {
    greeter
}
WORK_VAR @funcExpr = (MEMBER(MEMBER(MEMBER(MEMBER(capturedCode, "funcStmt"), #COMPS), 2), #EXPRS))
SET funcExpr = (MEMBER(funcExpr, 0))
WORK_VAR @procStmt = (MEMBER(MEMBER(MEMBER(MEMBER(capturedCode, "procStmt"), #COMPS), 2), #STMTS))
SET procStmt = (MEMBER(procStmt, 0))
PRINT(MEMBER(funcExpr, #PHASE))
PRINT(CALL_METHOD(funcExpr, #describe))
PRINT(MEMBER(procStmt, #PHASE))
PRINT(CALL_METHOD(procStmt, #greet))
PRINT(CALL_METHOD(procStmt, #greet))
>>> expectPrint
#PREP_PHASE
Invocation of ADD in #WORK_PHASE
#PREP_PHASE
Prepping greeter
Hello in #WORK_PHASE
Hello in #WORK_PHASE
