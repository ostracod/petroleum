>>> commonFile ~/targetPackage/testUtils.petrol
PREP_VAR @capturedCode = <MAP [FIELDS []]>
COMMENT "Usage: capture \"name\" $comps"
COMMENT "Stores the invocation statement in `capturedCode` without prepping child workers."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @nameComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            SET_MEMBER(capturedCode, MEMBER(nameComp, #STR), worker)
        })
    ]])
]]>
=========================
>>> testCase "Custom methods on expressions"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode]]
PREP_SYMBOL @#describe
SET_MEMBER(INT_EXPR_METHODS, #describe, FUNC {
    [ARGS [@worker, @prefix]]
    RET (CONCAT(LIST (prefix, "integer ", STR(MEMBER(worker, #INT)))))
})
SET_MEMBER(STR_EXPR_METHODS, #describe, FUNC {
    [ARGS [@worker, @prefix]]
    RET (CONCAT(LIST (prefix, "string ", MEMBER(worker, #STR))))
})
SET_MEMBER(IDENT_EXPR_METHODS, #describe, FUNC {
    [ARGS [@worker, @prefix]]
    RET (CONCAT(LIST (prefix, "identifier ", MEMBER(worker, #IDENT))))
})
SET_MEMBER(FUNC_INVOC_METHODS, #describe, FUNC {
    [ARGS [@worker, @prefix]]
    RET (CONCAT(LIST (prefix, "invocation of ", STR(MEMBER(worker, #INVOC)))))
})
WORK_VAR @myVar = (10)
capture "myStmt" (123, "text", myVar, ADD(1, 2))
WORK_VAR @exprs = (MEMBER(MEMBER(MEMBER(MEMBER(capturedCode, "myStmt"), #COMPS), 2), #EXPRS))
PRINT(MEMBER(MEMBER(exprs, 0), #PHASE))
PRINT(CALL_METHOD(MEMBER(exprs, 0), #describe, LIST ("Found ")))
PRINT(CALL_METHOD(MEMBER(exprs, 1), #describe, LIST ("Found ")))
PRINT(CALL_METHOD(MEMBER(exprs, 2), #describe, LIST ("Found ")))
PRINT(CALL_METHOD(MEMBER(exprs, 3), #describe, LIST ("Found ")))
COMMENT "Custom methods cause workers to enter work-phase first."
PRINT(MEMBER(MEMBER(exprs, 0), #PHASE))
>>> expectPrint
#PREP_PHASE
Found integer 123
Found string text
Found identifier myVar
Found invocation of ADD
#WORK_PHASE
