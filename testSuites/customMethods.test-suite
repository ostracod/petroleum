IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode]]
PREP_SYMBOL @#countNodes
SET_MEMBER(EXPR_COMP_METHODS, #countNodes, FUNC {
    [ARGS [@worker]]
    RET (LEN(MEMBER(worker, #EXPRS)))
})
SET_MEMBER(STMTS_COMP_METHODS, #countNodes, FUNC {
    [ARGS [@worker]]
    RET (LEN(MEMBER(worker, #STMTS)))
})
capture "exprsStmt" (1, 2, 3)
capture "stmtsStmt" {
    PRINT("This line is not reached")
    PRINT("This line is not reached")
}
WORK_VAR @exprsComp = (MEMBER(MEMBER(MEMBER(capturedCode, "exprsStmt"), #COMPS), 2))
WORK_VAR @stmtsComp = (MEMBER(MEMBER(MEMBER(capturedCode, "stmtsStmt"), #COMPS), 2))
PRINT(CALL_METHOD(exprsComp, #countNodes))
PRINT(CALL_METHOD(stmtsComp, #countNodes))
>>> expectPrint
