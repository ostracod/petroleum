>>> testCase "Exception reporter throws exception to next reporter"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @reporter1 {
    [ARGS [@excep]]
    RET (CONCAT(LIST ("Reporter 1: ", MEMBER(excep, #MESSAGE))))
}
PREP_FUNC @reporter2 {
    [ARGS [@excep]]
    PRINT(LIST ("Reporter 2", MEMBER(excep, #MESSAGE)))
    THROW (MAP [FIELDS [
        (#EXCEP_TYPE) = (#ERROR_EXCEP)
        (#ERROR_TYPE) = (#STATE_ERROR)
        (#MESSAGE) = ("Reporter 2 failed")
    ]])
}
PREP_FUNC @reporter3 {
    [ARGS [@excep]]
    PRINT(LIST ("Reporter 3", MEMBER(excep, #MESSAGE)))
    ABORT (#VALUE_ERROR, "Reporter 3 failed")
}
ADD_EXCEP_REPORTER(reporter1)
ADD_EXCEP_REPORTER(reporter2)
