>>> testCase "EXCEP_TO_STR function with #WORKER_NODE field"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @fail {
    [ARGS [@node]]
    THROW (MAP [FIELDS [
        (#EXCEP_TYPE) = (#ERROR_EXCEP)
        (#ERROR_TYPE) = (#VALUE_ERROR)
        (#MESSAGE) = ("Value must be positive.")
        (#WORKER_NODE) = (node)
    ]])
}
PREP_VAR @checkPositive = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#EVAL) = (FUNC {
            [ARGS [@worker, @frame]]
            WORK_VAR @exprsComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            WORK_VAR @values = (CALL_METHOD(exprsComp, #EVAL, LIST (frame)))
            IF (LESS_EQUAL(MEMBER(values, 0), 0)) {
                fail(worker)
            }
        })
    ]])
]]>
PREP_FUNC @useCheck {
    [ARGS [@value]]
    checkPositive (value)
}
PREP_FUNC @outer {
    useCheck(0)
}
WORK_VAR @excep
TRY {
    outer()
} CATCH {
    [EXCEP @caughtExcep]
    SET excep = (caughtExcep)
}
PREP_FUNC @topStmt {
    [ARGS [@index]]
    WORK_VAR @module = (LOAD_MODULE ("./main.petrol"))
    RET (MEMBER(MEMBER(MEMBER(module, #STMTS_COMP), #STMTS), index))
}
PREP_FUNC @firstBodyStmt {
    [ARGS [@stmt, @compIndex]]
    WORK_VAR @stmtsComp = (MEMBER(MEMBER(stmt, #COMPS), compIndex))
    RET (MEMBER(MEMBER(stmtsComp, #STMTS), 0))
}
COMMENT "The stack trace starts at the custom procedure invocation."
PRINT(EXCEP_TO_STR(excep))
COMMENT "The stack trace starts at the invocation of `useCheck` in `outer`."
WORK_VAR @outerStmt = (topStmt(3))
SET_MEMBER(excep, #WORKER_NODE, firstBodyStmt(outerStmt, 2))
PRINT(EXCEP_TO_STR(excep))
COMMENT "The stack trace only contains the invocation of `outer`."
SET_MEMBER(excep, #WORKER_NODE, firstBodyStmt(topStmt(5), 1))
PRINT(EXCEP_TO_STR(excep))
COMMENT "The stack trace is complete when the node is not in the stack trace."
SET_MEMBER(excep, #WORKER_NODE, outerStmt)
PRINT(EXCEP_TO_STR(excep))
COMMENT "The stack trace is complete when the field is absent."
DEL_FIELD(excep, #WORKER_NODE)
PRINT(EXCEP_TO_STR(excep))
