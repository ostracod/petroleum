>>> testCase "EXCEP_TO_STR function with exception reporter returning non-string"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @reporter1 {
    [ARGS [@excep]]
    PRINT(LIST (MEMBER(excep, #ERROR_TYPE), MEMBER(excep, #MESSAGE)))
    RET ("Reporter 1 output")
}
PREP_FUNC @reporter2 {
    [ARGS [@excep]]
    RET (123)
}
WORK_VAR @excep = (MAP [FIELDS [
    (#EXCEP_TYPE) = (#ERROR_EXCEP)
    (#ERROR_TYPE) = (#VALUE_ERROR)
    (#MESSAGE) = ("Bad value")
]])
COMMENT "The type error is passed to the default reporter."
ADD_EXCEP_REPORTER(reporter2)
WORK_VAR @excepText = (EXCEP_TO_STR(excep))
PRINT(MEMBER(SPLIT(excepText, "\n"), 0))
COMMENT "The type error is passed to the next reporter."
ADD_EXCEP_REPORTER(reporter1)
ADD_EXCEP_REPORTER(reporter2)
PRINT(EXCEP_TO_STR(excep))
