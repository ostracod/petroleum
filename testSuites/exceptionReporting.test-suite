>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @nodes = <MAP [FIELDS []]>
PREP_VAR @failProc = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
