>>> testCase "Stuck coroutines with #WORKER_NODE field"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @isPresent {
    [ARGS [@member]]
    RET (TRUE)
}
COMMENT "Usage: procWithEval($evalFunc)"
COMMENT "Creates a custom procedure with the given #EVAL method."
PREP_FUNC @procWithEval {
    [ARGS [@evalFunc]]
    RET (MAP [FIELDS [
        (#IS_PROC) = (TRUE)
        (#METHODS) = (MAP [FIELDS [(#EVAL) = (evalFunc)]])
    ]])
}
PREP_VAR @awaitForever = <procWithEval(FUNC {
    [ARGS [@worker, @frame]]
    THROW (MAP [FIELDS [
        (#EXCEP_TYPE) = (#AWAIT_EXCEP)
        (#BUNCH) = (MAP [FIELDS []])
        (#LOC) = ("a")
        (#COND) = (isPresent)
        (#MESSAGE) = ("Waiting for a")
        (#WORKER_NODE) = (worker)
    ]])
})>
PREP_VAR @spinForever = <procWithEval(FUNC {
    [ARGS [@worker, @frame]]
    THROW (MAP [FIELDS [
        (#EXCEP_TYPE) = (#SPIN_EXCEP)
        (#COND) = (FUNC {RET (FALSE)})
        (#MESSAGE) = ("Spinning forever")
        (#WORKER_NODE) = (worker)
    ]])
})>
SCHED {
    awaitForever ()
}
SCHED {
    spinForever ()
}
