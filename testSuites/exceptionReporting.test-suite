>>> testCase "Exceptions during prep-phase are reported after all coroutines end"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @flags = <MAP [FIELDS []]>
PREP_VAR @var1 = <RUN {
    ABORT (#STATE_ERROR, "First error")
}>
PREP_VAR @var2 = <RUN {
    SPIN (FUNC {
        RET (HAS_KEY(flags, "ready"))
    }, "Waiting for ready flag")
    PRINT("Spinning coroutine finished")
    ABORT (#VALUE_ERROR, "Second error")
}>
PREP_VAR @var3 = <RUN {
    PRINT("Setting ready flag")
    SET_MEMBER(flags, "ready", TRUE)
}>
PRINT("This line is not reached")
>>> expectPrint
Setting ready flag
Spinning coroutine finished
>>> expectError type: #STATE_ERROR message: "First error" lineNumber: 3
>>> expectError type: #VALUE_ERROR message: "Second error" lineNumber: 10
=========================
>>> testCase "Exception during prep-phase of imported module"
>>> setupFile ~/targetPackage/otherModule.petrol
PREP_VAR @otherVar = <RUN {
    ABORT (#STATE_ERROR, "Error in other module")
}>
PRINT("This line is not reached")
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./otherModule.petrol">
PREP <RUN {
    PRINT("Prepping main module")
}>
PRINT("This line is not reached")
>>> expectPrint
Prepping main module
>>> expectError type: #STATE_ERROR message: "Error in other module" path: ~/targetPackage/otherModule.petrol lineNumber: 2
=========================
>>> testCase "Non-error exception during prep-phase"
>>> setupFile ~/targetPackage/main.petrol
PREP <RUN {
    BREAK
}>
PREP <RUN {
    PRINT("Still prepping")
}>
PRINT("This line is not reached")
>>> expectPrint
Still prepping
>>> expectExcep type: #BREAK_EXCEP lineNumber: 2
