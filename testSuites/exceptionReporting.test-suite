>>> testCase "EXCEP_TO_STR function with exception types"
>>> setupFile ~/targetPackage/main.petrol
PREP_SYMBOL @#MY_ERROR
PREP_SYMBOL @#MY_EXCEP
PREP_FUNC @isPresent {
    [ARGS [@member]]
    RET (TRUE)
}
TRY {
    ABORT (#VALUE_ERROR, "Bad value")
} CATCH {
    [EXCEP @excep]
    PRINT(EXCEP_TO_STR(excep))
}
TRY {
    ABORT (#MY_ERROR, "Custom error")
} CATCH {
    [EXCEP @excep]
    PRINT(EXCEP_TO_STR(excep))
}
TRY {
    THROW (MAP [FIELDS [(#EXCEP_TYPE) = (#MY_EXCEP)]])
} CATCH {
    [EXCEP @excep]
    PRINT(EXCEP_TO_STR(excep))
}
TRY {
    AWAIT (MAP [FIELDS []], "a", isPresent, "Waiting for a")
} CATCH {
    [EXCEP @excep]
    PRINT(EXCEP_TO_STR(excep))
}
TRY {
    AWAIT (MAP [FIELDS []], "a", isPresent, NULL)
} CATCH {
    [EXCEP @excep]
    PRINT(EXCEP_TO_STR(excep))
}
TRY {
    SPIN (FUNC {RET (FALSE)}, "Spinning forever")
} CATCH {
    [EXCEP @excep]
    PRINT(EXCEP_TO_STR(excep))
}
TRY {
    BREAK
} CATCH {
    [EXCEP @excep]
    PRINT(EXCEP_TO_STR(excep))
}
