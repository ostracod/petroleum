>>> testCase "Exception reporter with spin exception"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @reporter1 {
    [ARGS [@excep]]
    PRINT(LIST ("Reporter 1", MEMBER(excep, #EXCEP_TYPE), MEMBER(excep, #MESSAGE)))
    RET ("Reporter 1 output")
}
PREP_FUNC @reporter2 {
    [ARGS [@excep]]
    WORK_VAR @flags = (MAP [FIELDS [("ready") = (FALSE)]])
    SCHED {
        PRINT("Setting flag")
        SET_MEMBER(flags, "ready", TRUE)
    }
    PRINT("Spinning")
    SPIN (FUNC {
        RET (MEMBER(flags, "ready"))
    }, "Waiting for flag")
    PRINT("Finished spinning")
    RET (CONCAT(LIST ("Reporter 2: ", MEMBER(excep, #MESSAGE))))
}
ADD_EXCEP_REPORTER(reporter1)
ADD_EXCEP_REPORTER(reporter2)
PRINT(EXCEP_TO_STR(MAP [FIELDS [
    (#EXCEP_TYPE) = (#ERROR_EXCEP)
    (#ERROR_TYPE) = (#VALUE_ERROR)
    (#MESSAGE) = ("Bad value")
]]))
>>> expectPrint
Spinning
Setting flag
Finished spinning
Reporter 2: Bad value
=========================
>>> testCase "Exception reporter with await exception"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @reporter1 {
    [ARGS [@excep]]
    PRINT(LIST ("Reporter 1", MEMBER(excep, #EXCEP_TYPE), MEMBER(excep, #MESSAGE)))
    RET ("Reporter 1 output")
}
PREP_FUNC @reporter2 {
    [ARGS [@excep]]
    WORK_VAR @myMap = (MAP [FIELDS []])
    SCHED {
        PRINT("Setting field")
        SET_MEMBER(myMap, "a", "Field value")
    }
    PRINT("Awaiting")
    WORK_VAR @value = (AWAIT (myMap, "a", FUNC {
        [ARGS [@member]]
        RET (TRUE)
    }, "Waiting for field"))
    PRINT(LIST ("Finished awaiting", value))
    RET (CONCAT(LIST ("Reporter 2: ", MEMBER(excep, #MESSAGE))))
}
ADD_EXCEP_REPORTER(reporter1)
ADD_EXCEP_REPORTER(reporter2)
PRINT(EXCEP_TO_STR(MAP [FIELDS [
    (#EXCEP_TYPE) = (#ERROR_EXCEP)
    (#ERROR_TYPE) = (#VALUE_ERROR)
    (#MESSAGE) = ("Bad value")
]]))
>>> expectPrint
Awaiting
Setting field
LIST ("Finished awaiting", "Field value")
Reporter 2: Bad value
