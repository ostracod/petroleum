>>> testCase "Stuck coroutine is not reported with exception during prep-phase"
>>> setupFile ~/targetPackage/main.petrol
COMMENT "This behavior is intentional. The exception is probably the root cause,"
COMMENT "so Petroleum does not report stuck conditions alongside the exception."
PREP_VAR @var1 = <RUN {
    ABORT (#STATE_ERROR, "An error")
}>
PREP_VAR @var2 = <RUN {
    SPIN (FUNC {RET (FALSE)}, "Stuck forever")
}>
PRINT("This line is not reached")
>>> expectError type: #STATE_ERROR message: "An error" lineNumber: 4
=========================
>>> testCase "Exception during work-phase terminates immediately"
>>> setupFile ~/targetPackage/main.petrol
SCHED {
    PRINT("This line is not reached")
}
PRINT("Before error")
ABORT (#STATE_ERROR, "Error in main coroutine")
PRINT("This line is not reached")
>>> expectPrint
Before error
>>> expectError type: #STATE_ERROR message: "Error in main coroutine" lineNumber: 5
=========================
>>> testCase "Exception in scheduled coroutine during work-phase terminates immediately"
>>> setupFile ~/targetPackage/main.petrol
SCHED {
    ABORT (#STATE_ERROR, "First error")
}
SCHED {
    ABORT (#STATE_ERROR, "This error is not reported")
}
PRINT("Main coroutine spinning")
COMMENT "The spinning coroutine is not reported as stuck."
SPIN (FUNC {RET (FALSE)}, "Waiting forever")
>>> expectPrint
Main coroutine spinning
>>> expectError type: #STATE_ERROR message: "First error" lineNumber: 2
