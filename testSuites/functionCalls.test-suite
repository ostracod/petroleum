>>> testCase "CALL function with arguments"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myFunc = (FUNC {
    [ARGS [@value1, @value2]]
    RET (SUB(value1, value2))
})
PRINT(CALL(myFunc, LIST(10, 3)))
PRINT(CALL(ADD, LIST(4, 5)))
>>> expectPrint
7
9
=========================
>>> testCase "CALL function without arguments"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myFunc = (FUNC {
    PRINT("Called myFunc")
})
PRINT(CALL(myFunc))
PRINT(CALL(myFunc, LIST()))
>>> expectPrint
Called myFunc
NULL
Called myFunc
NULL
=========================
>>> testCase "CALL function with argument list"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myFunc = (FUNC {
    [ARGS @args]
    RET (LEN(args))
})
PRINT(CALL(myFunc, LIST(10, 20, 30)))
PRINT(CALL(myFunc))
>>> expectPrint
3
0
=========================
>>> testCase "CALL function with closure"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @createCounter = (FUNC {
    WORK_VAR @count = (0)
    RET (FUNC {
        SET count = (ADD(count, 1))
        RET (count)
    })
})
WORK_VAR @counter1 = (CALL(createCounter))
WORK_VAR @counter2 = (CALL(createCounter))
PRINT(CALL(counter1))
PRINT(CALL(counter1))
PRINT(CALL(counter2))
PRINT(CALL(counter1))
>>> expectPrint
1
2
1
3
=========================
>>> testCase "CALL function with function chosen during work-phase"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @funcs = (LIST(ADD, SUB, MUL))
WORK_VAR @index = (0)
WHILE (LESS(index, LEN(funcs))) {
    PRINT(CALL(MEMBER(funcs, index), LIST(6, 3)))
    SET index = (ADD(index, 1))
}
>>> expectPrint
9
3
18
=========================
>>> testCase "CALL function does not modify argument list"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myFunc = (FUNC {
    [ARGS @args]
    ADD_ELEM(args, 99)
    RET (args)
})
WORK_VAR @myArgs = (LIST(10, 20))
PRINT(CALL(myFunc, myArgs))
PRINT(myArgs)
>>> expectPrint
LIST (10, 20, 99)
LIST (10, 20)
