>>> testCase "CALL function with arguments"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myFunc = (FUNC {
    [ARGS [@value1, @value2]]
    RET (SUB(value1, value2))
})
PRINT(CALL(myFunc, LIST(10, 3)))
PRINT(CALL(ADD, LIST(4, 5)))
>>> expectPrint
