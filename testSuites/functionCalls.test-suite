>>> testCase "MIN_ARG_AMOUNT and MAX_ARG_AMOUNT with required arguments"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @noArgs {
    RET (1)
}
PREP_FUNC @emptyArgs {
    [ARGS []]
    RET (1)
}
PREP_FUNC @twoArgs {
    [ARGS [@value1, @value2]]
    RET (ADD(value1, value2))
}
WORK_VAR @workFunc = (FUNC {
    [ARGS [@value]]
    RET (value)
})
PRINT(LIST (MIN_ARG_AMOUNT(noArgs), MAX_ARG_AMOUNT(noArgs)))
PRINT(LIST (MIN_ARG_AMOUNT(emptyArgs), MAX_ARG_AMOUNT(emptyArgs)))
PRINT(LIST (MIN_ARG_AMOUNT(twoArgs), MAX_ARG_AMOUNT(twoArgs)))
PRINT(LIST (MIN_ARG_AMOUNT(workFunc), MAX_ARG_AMOUNT(workFunc)))
>>> expectPrint
LIST (0, 0)
LIST (0, 0)
LIST (2, 2)
LIST (1, 1)
=========================
>>> testCase "MIN_ARG_AMOUNT and MAX_ARG_AMOUNT with optional arguments"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @mixedArgs {
    [ARGS [@value1, @value2 = (2), @value3 = (3)]]
    RET (LIST (value1, value2, value3))
}
PREP_FUNC @optionalArgs {
    [ARGS [@value1 = (1), @value2 = (2)]]
    RET (LIST (value1, value2))
}
PRINT(LIST (MIN_ARG_AMOUNT(mixedArgs), MAX_ARG_AMOUNT(mixedArgs)))
PRINT(LIST (MIN_ARG_AMOUNT(optionalArgs), MAX_ARG_AMOUNT(optionalArgs)))
>>> expectPrint
