>>> testCase "BREAK procedure"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @count = (0)
WHILE (TRUE) {
    SET count = (ADD(count, 1))
    IF (EQUAL(count, 3)) {
        BREAK
        PRINT("This line is not reached")
    }
    PRINT(count)
}
PRINT("After loop")
>>> expectPrint
1
2
After loop
=========================
>>> testCase "BREAK procedure in nested loops"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @outerCount = (0)
WHILE (LESS(outerCount, 2)) {
    SET outerCount = (ADD(outerCount, 1))
    WORK_VAR @innerCount = (0)
    WHILE (TRUE) {
        SET innerCount = (ADD(innerCount, 1))
        IF (GREATER(innerCount, 2)) {
            BREAK
        }
        PRINT(CONCAT(LIST (STR(outerCount), ", ", STR(innerCount))))
    }
}
>>> expectPrint
1, 1
1, 2
2, 1
2, 2
=========================
>>> testCase "CONT procedure"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @count = (0)
WHILE (LESS(count, 5)) {
    SET count = (ADD(count, 1))
    IF (EQUAL(MOD(count, 2), 0)) {
        CONT
        PRINT("This line is not reached")
    }
    PRINT(count)
}
PRINT("After loop")
>>> expectPrint
