>>> testCase "IF procedure"
>>> setupFile ~/targetPackage/main.petrol
IF (TRUE) {
    PRINT("First")
}
IF (FALSE) {
    PRINT("This line is not reached")
}
IF (5) {
    PRINT("Second")
}
IF (FALSE) {
    PRINT("This line is not reached")
} ELSE {
    PRINT("Third")
}
IF (TRUE) {
    PRINT("Fourth")
} ELSE {
    PRINT("This line is not reached")
}
>>> expectPrint
First
Second
Third
Fourth
=========================
>>> testCase "IF procedure with ELSE_IF clauses"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @check = <FUNC {
    [ARGS [@name, @value]]
    PRINT(CONCAT(LIST ("Checking ", name)))
    RET (value)
}>
IF (check("a", FALSE)) {
    PRINT("This line is not reached")
} ELSE_IF (check("b", TRUE)) {
    PRINT("Evaluating b")
} ELSE_IF (check("c", TRUE)) {
    PRINT("This line is not reached")
} ELSE {
    PRINT("This line is not reached")
}
IF (check("d", FALSE)) {
    PRINT("This line is not reached")
} ELSE_IF (check("e", FALSE)) {
    PRINT("This line is not reached")
}
IF (check("f", FALSE)) {
    PRINT("This line is not reached")
} ELSE_IF (check("g", FALSE)) {
    PRINT("This line is not reached")
} ELSE {
    PRINT("Evaluating else")
}
>>> expectPrint
Checking a
Checking b
Evaluating b
Checking d
Checking e
Checking f
Checking g
Evaluating else
=========================
