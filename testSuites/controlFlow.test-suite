>>> testCase "RET procedure"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @withValue = <FUNC {
    RET ("Returned value")
    PRINT("This line is not reached")
}>
PREP_VAR @withoutValue = <FUNC {
    RET
    PRINT("This line is not reached")
}>
PREP_VAR @inLoop = <FUNC {
    WORK_VAR @count = (0)
    WHILE (TRUE) {
        SET count = (ADD(count, 1))
        IF (EQUAL(count, 3)) {
            RET (count)
        }
    }
}>
PRINT(withValue())
PRINT(withoutValue())
PRINT(inLoop())
>>> expectPrint
Returned value
NULL
3
=========================
>>> testCase "RET procedure with level"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @nested = <FUNC {
    WORK_VAR @value = (RUN {
        RET ("Level 0", 0)
    })
    PRINT(value)
    RUN {
        RET ("Level 1", 1)
    }
    PRINT("This line is not reached")
}>
PRINT(nested())
PREP_VAR @exitCaller = <FUNC {
    RET ("Level 1 from function", 1)
}>
PRINT(RUN {
    exitCaller()
    PRINT("This line is not reached")
})
PREP_VAR @exitTwice = <FUNC {
    RUN {
        RUN {
            RET ("Level 2", 2)
        }
        PRINT("This line is not reached")
    }
    PRINT("This line is not reached")
}>
PRINT(exitTwice())
>>> expectPrint
Level 0
Level 1
Level 1 from function
Level 2
=========================
>>> testCase "RET exceptions"
>>> setupFile ~/targetPackage/main.petrol
TRY {
    RET ("myValue", 2)
} CATCH {
    [EXCEP @excep]
    PRINT(MEMBER(excep, #EXCEP_TYPE))
    PRINT(MEMBER(excep, #VALUE))
    PRINT(MEMBER(excep, #RET_LEVEL))
    PRINT(TYPE(MEMBER(excep, #EVAL_STATE)))
}
TRY {
    RET (5)
} CATCH {
    [EXCEP @excep]
    PRINT(MEMBER(excep, #VALUE))
    PRINT(MEMBER(excep, #RET_LEVEL))
}
TRY {
    RET
} CATCH {
    [EXCEP @excep]
    PRINT(MEMBER(excep, #VALUE))
    PRINT(MEMBER(excep, #RET_LEVEL))
}
>>> expectPrint
#RET_EXCEP
myValue
2
#EVAL_STATE
5
0
NULL
0
