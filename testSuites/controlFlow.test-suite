>>> testCase "BREAK and CONT exceptions"
>>> setupFile ~/targetPackage/main.petrol
TRY {
    BREAK
} CATCH {
    [EXCEP @excep]
    PRINT(MEMBER(excep, #EXCEP_TYPE))
    PRINT(TYPE(MEMBER(excep, #EVAL_STATE)))
}
TRY {
    CONT
} CATCH {
    [EXCEP @excep]
    PRINT(MEMBER(excep, #EXCEP_TYPE))
    PRINT(TYPE(MEMBER(excep, #EVAL_STATE)))
}
WORK_VAR @count = (0)
WHILE (LESS(count, 2)) {
    SET count = (ADD(count, 1))
    TRY {
        BREAK
    } CATCH {
        PRINT("Caught break")
    }
}
>>> expectPrint
#BREAK_EXCEP
#EVAL_STATE
#CONT_EXCEP
#EVAL_STATE
Caught break
Caught break
=========================
