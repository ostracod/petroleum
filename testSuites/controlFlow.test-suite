>>> testCase "ITER procedure with fields deleted from map during iteration"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @newMap {
    RET (MAP [FIELDS [("a") = (1), ("b") = (2), ("c") = (3), ("d") = (4)]])
}
COMMENT "Usage: iterAndDelete($deleteKeys)"
COMMENT "Iterates over a new map. When visiting each key in $deleteKeys,"
COMMENT "deletes the listed keys. Prints the visited keys and the final map."
PREP_FUNC @iterAndDelete {
    [ARGS [@deleteKeys]]
    WORK_VAR @myMap = (newMap())
    WORK_VAR @visitedKeys = (LIST ())
    ITER (myMap) {
        [LOC @key]
        ADD_ELEM(visitedKeys, key)
        IF (HAS_KEY(deleteKeys, key)) {
            ITER (MEMBER(deleteKeys, key)) {
                [MEMBER @deleteKey]
                DEL_FIELD(myMap, deleteKey)
            }
        }
    }
    PRINT(visitedKeys)
    PRINT(KEYS(myMap))
}
COMMENT "Current field"
iterAndDelete(MAP [FIELDS [("b") = (LIST ("b"))]])
COMMENT "Next field"
iterAndDelete(MAP [FIELDS [("b") = (LIST ("c"))]])
COMMENT "Later field"
iterAndDelete(MAP [FIELDS [("a") = (LIST ("c"))]])
COMMENT "Earlier fields"
iterAndDelete(MAP [FIELDS [("c") = (LIST ("a", "b"))]])
COMMENT "Current and next fields"
iterAndDelete(MAP [FIELDS [("b") = (LIST ("b", "c"))]])
COMMENT "Current field, then previous field"
iterAndDelete(MAP [FIELDS [("c") = (LIST ("c", "b"))]])
COMMENT "Previous field, then current field"
iterAndDelete(MAP [FIELDS [("c") = (LIST ("b", "c"))]])
COMMENT "Each field when it is visited"
iterAndDelete(MAP [FIELDS [
    ("a") = (LIST ("a"))
    ("b") = (LIST ("b"))
    ("c") = (LIST ("c"))
    ("d") = (LIST ("d"))
]])
COMMENT "Fields at different times"
iterAndDelete(MAP [FIELDS [
    ("a") = (LIST ("b"))
    ("c") = (LIST ("c", "a"))
]])
COMMENT "Last field while visiting the last field"
iterAndDelete(MAP [FIELDS [("d") = (LIST ("d"))]])
>>> expectPrint
LIST ("a", "b", "c", "d")
LIST ("a", "c", "d")
LIST ("a", "b", "d")
LIST ("a", "b", "d")
LIST ("a", "b", "d")
LIST ("a", "b", "d")
LIST ("a", "b", "c", "d")
LIST ("c", "d")
LIST ("a", "b", "d")
LIST ("a", "d")
LIST ("a", "b", "c", "d")
LIST ("a", "d")
LIST ("a", "b", "c", "d")
LIST ("a", "d")
LIST ("a", "b", "c", "d")
LIST ()
LIST ("a", "c", "d")
LIST ("d")
LIST ("a", "b", "c", "d")
LIST ("a", "b", "c")
=========================
>>> testCase "ITER procedure with fields deleted and added during iteration"
>>> setupFile ~/targetPackage/main.petrol
COMMENT "Deleting every field and adding a new field"
WORK_VAR @myMap = (MAP [FIELDS [("a") = (1), ("b") = (2), ("c") = (3)]])
ITER (myMap) {
    [LOC @key]
    PRINT(key)
    IF (EQUAL(key, "b")) {
        DEL_FIELD(myMap, "a")
        DEL_FIELD(myMap, "b")
        DEL_FIELD(myMap, "c")
        SET_MEMBER(myMap, "d", 4)
    }
}
PRINT(myMap)
COMMENT "A deleted key which is added again is visited again."
SET myMap = (MAP [FIELDS [("a") = (1), ("b") = (2)]])
ITER (myMap) {
    [LOC @key, MEMBER @value]
    PRINT(LIST (key, value))
    IF (EQUAL(value, 1)) {
        DEL_FIELD(myMap, "a")
        SET_MEMBER(myMap, "a", 10)
    }
}
PRINT(myMap)
COMMENT "A field which is added and then deleted before being reached is not visited."
SET myMap = (MAP [FIELDS [("a") = (1), ("b") = (2)]])
ITER (myMap) {
    [LOC @key]
    PRINT(key)
    IF (EQUAL(key, "a")) {
        SET_MEMBER(myMap, "c", 3)
        SET_MEMBER(myMap, "d", 4)
        DEL_FIELD(myMap, "c")
    }
}
PRINT(myMap)
>>> expectPrint
a
b
d
MAP [FIELDS [("d") = (4)]]
LIST ("a", 1)
LIST ("b", 2)
LIST ("a", 10)
MAP [FIELDS [("b") = (2), ("a") = (10)]]
a
b
d
MAP [FIELDS [("a") = (1), ("b") = (2), ("d") = (4)]]
=========================
>>> testCase "ITER procedure with map changed by another coroutine during iteration"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @isPresent {
    [ARGS [@member]]
    RET (TRUE)
}
WORK_VAR @myMap = (MAP [FIELDS [("a") = (1), ("b") = (2), ("c") = (3)]])
WORK_VAR @flags = (MAP [FIELDS []])
SCHED {
    PRINT("Changing map")
    DEL_FIELD(myMap, "a")
    DEL_FIELD(myMap, "b")
    SET_MEMBER(myMap, "c", 30)
    SET_MEMBER(myMap, "d", 4)
    SET_MEMBER(flags, "done", TRUE)
}
ITER (myMap) {
    [LOC @key, MEMBER @value]
    PRINT(LIST (key, value))
    IF (EQUAL(key, "a")) {
        AWAIT (flags, "done", isPresent, "Waiting for map change")
    }
}
>>> expectPrint
LIST ("a", 1)
Changing map
LIST ("c", 30)
LIST ("d", 4)
