>>> testCase "Integer overflow"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @maxInt = (9223372036854775807)
WORK_VAR @minInt = (SUB(NEG(maxInt), 1))
PRINT(minInt)
PRINT(ADD(maxInt, 1))
PRINT(SUB(minInt, 1))
PRINT(MUL(maxInt, 2))
PRINT(NEG(minInt))
PRINT(DIV(minInt, NEG(1)))
>>> expectPrint
-9223372036854775808
-9223372036854775808
9223372036854775807
-2
-9223372036854775808
-9223372036854775808
=========================
