>>> testCase "PARSE function reverses STR function"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <#JSON> [VARS [@PARSE, @STR]]
WORK_VAR @texts = (LIST (
    "123"
    "\"text\""
    "null"
    "[1,\"two\",null,[3,[]]]"
    "{\"b\":1,\"a\":{\"c\":[\"x\"]}}"
))
WORK_VAR @index = (0)
WHILE (LESS(index, LEN(texts))) {
    WORK_VAR @text = (MEMBER(texts, index))
    PRINT(EQUAL(STR(PARSE(text)), text))
    SET index = (ADD(index, 1))
}
WORK_VAR @data = (MAP [FIELDS [("a") = (LIST (1, NEG(2))), ("b") = ("c")]])
PRINT(PARSE(STR(data)))
PRINT(PARSE(STR(data, 2)))
>>> expectPrint
1
1
1
1
1
MAP [FIELDS [("a") = (LIST (1, -2)), ("b") = ("c")]]
MAP [FIELDS [("a") = (LIST (1, -2)), ("b") = ("c")]]
