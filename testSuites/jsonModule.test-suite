>>> testCase "STR function with circular references"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <#JSON> [VARS [@STR]]
IMPORT <"./testUtils.petrol"> [VARS [@printError]]
WORK_VAR @myList = (LIST (1, 2))
ADD_ELEM(myList, myList)
printError(STR, LIST (myList))
WORK_VAR @myMap = (MAP [FIELDS [("a") = (1)]])
SET_MEMBER(myMap, "self", myMap)
printError(STR, LIST (myMap))
WORK_VAR @outerList = (LIST ())
WORK_VAR @innerMap = (MAP [FIELDS [("list") = (outerList)]])
ADD_ELEM(outerList, LIST (innerMap))
printError(STR, LIST (outerList))
printError(STR, LIST (innerMap))
printError(STR, LIST (LIST ("wrapper", myList)))
>>> expectPrint
