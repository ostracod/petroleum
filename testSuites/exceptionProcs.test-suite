>>> testCase "TRY procedure nested"
>>> setupFile ~/targetPackage/main.petrol
TRY {
    TRY {
        ABORT (#STATE_ERROR, "First error")
    } CATCH {
        [EXCEP @excep]
        PRINT(CONCAT(LIST ("Inner caught: ", MEMBER(excep, #MESSAGE))))
        ABORT (#STATE_ERROR, "Second error")
    }
    PRINT("This line is not reached")
} CATCH {
    [EXCEP @excep]
    PRINT(CONCAT(LIST ("Outer caught: ", MEMBER(excep, #MESSAGE))))
}
TRY {
    ABORT (#STATE_ERROR, "Uncaught error")
} CATCH {
    PRINT("Caught")
    ABORT (#STATE_ERROR, "Error in CATCH")
}
>>> expectPrint
Inner caught: First error
Outer caught: Second error
Caught
>>> expectError type: #STATE_ERROR message: "Error in CATCH" lineNumber: 18
=========================
