>>> testCase "THROW procedure"
>>> setupFile ~/targetPackage/main.petrol
PREP_SYMBOL @#MY_EXCEP
WORK_VAR @myExcep = (MAP [FIELDS [
    (#EXCEP_TYPE) = (#MY_EXCEP)
    ("myData") = (123)
]])
TRY {
    THROW (myExcep)
    PRINT("This line is not reached")
} CATCH {
    [EXCEP @excep]
    PRINT(EQUAL(excep, myExcep))
    PRINT(MEMBER(excep, #EXCEP_TYPE))
    PRINT(MEMBER(excep, "myData"))
    PRINT(TYPE(MEMBER(excep, #EVAL_STATE)))
}
>>> expectPrint
1
#MY_EXCEP
123
#EVAL_STATE
=========================
>>> testCase "THROW procedure with existing evaluation state"
>>> setupFile ~/targetPackage/main.petrol
PREP_SYMBOL @#MY_EXCEP
WORK_VAR @firstEvalState
TRY {
    TRY {
        THROW (MAP [FIELDS [(#EXCEP_TYPE) = (#MY_EXCEP)]])
        PRINT("Resumed after first throw")
    } CATCH {
        [EXCEP @excep]
        SET firstEvalState = (MEMBER(excep, #EVAL_STATE))
        THROW (excep)
    }
    PRINT("After inner TRY")
} CATCH {
    [EXCEP @excep]
    PRINT(EQUAL(MEMBER(excep, #EVAL_STATE), firstEvalState))
    RESUME (MEMBER(excep, #EVAL_STATE))
}
PRINT("After outer TRY")
>>> expectPrint
1
Resumed after first throw
After inner TRY
After outer TRY
=========================
