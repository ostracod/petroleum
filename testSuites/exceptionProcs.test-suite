>>> testCase "TRY procedure"
>>> setupFile ~/targetPackage/main.petrol
TRY {
    PRINT("No exception")
} CATCH {
    PRINT("This line is not reached")
}
TRY {
    PRINT(DIV(10, 0))
    PRINT("This line is not reached")
} CATCH {
    [EXCEP @excep]
    PRINT(MEMBER(excep, #ERROR_TYPE))
    PRINT(MEMBER(excep, #MESSAGE))
}
TRY {
    ABORT (#STATE_ERROR, "Ignored error")
} CATCH {
    PRINT("Caught without variable")
}
PRINT("After TRY")
