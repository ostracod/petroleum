>>> testCase "RESUME procedure"
>>> setupFile ~/targetPackage/main.petrol
PREP_SYMBOL @#MY_EXCEP
WORK_VAR @myList = (LIST ())
TRY {
    ADD_ELEM(myList, 30)
    THROW (MAP [FIELDS [(#EXCEP_TYPE) = (#MY_EXCEP)]])
    ADD_ELEM(myList, 31)
} CATCH {
    [EXCEP @excep]
    ADD_ELEM(myList, 40)
    RESUME (MEMBER(excep, #EVAL_STATE))
    PRINT("This line is not reached")
}
PRINT(myList)
>>> expectPrint
LIST (30, 40, 31)
