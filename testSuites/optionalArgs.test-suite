>>> testCase "Default value in closure outlives enclosing scope"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @createGreeter {
    [ARGS [@defaultGreeting]]
    COMMENT "Only the default value accesses `defaultGreeting`."
    RET (FUNC {
        [ARGS [@name, @greeting = (defaultGreeting)]]
        RET (CONCAT(LIST (greeting, ", ", name)))
    })
}
WORK_VAR @greeter1 = (createGreeter("Hello"))
WORK_VAR @greeter2 = (createGreeter("Howdy"))
PRINT(CALL(greeter1, LIST ("Alice")))
PRINT(CALL(greeter2, LIST ("Bob")))
PRINT(CALL(greeter2, LIST ("Carol", "Hi")))
>>> expectPrint
Hello, Alice
Howdy, Bob
Hi, Carol
=========================
>>> testCase "Default value in nested function accesses outer variable"
>>> setupFile ~/targetPackage/main.petrol
RUN {
    WORK_VAR @defaultValue = (5)
    WORK_VAR @createFunc = (FUNC {
        COMMENT "Only the default value of the inner function accesses `defaultValue`."
        RET (FUNC {
            [ARGS [@value = (defaultValue)]]
            RET (value)
        })
    })
    WORK_VAR @myFunc = (CALL(createFunc))
    PRINT(CALL(myFunc))
}
>>> expectPrint
5
