>>> testCase "Wrong number of arguments with optional arguments using CALL"
>>> setupFile ~/targetPackage/main.petrol
WORK_VAR @myFunc = (FUNC {
    [ARGS [@value1, @value2 = (2)]]
})
TRY {
    CALL(myFunc)
} CATCH {
    [EXCEP @excep]
    PRINT(MEMBER(excep, #MESSAGE))
}
TRY {
    CALL(myFunc, LIST (1, 2, 3))
} CATCH {
    [EXCEP @excep]
    PRINT(MEMBER(excep, #MESSAGE))
}
