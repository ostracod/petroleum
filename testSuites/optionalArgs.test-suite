>>> testCase "Default value refers to earlier arguments"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @makeRange {
    [ARGS [@start, @end = (ADD(start, 3)), @step = (1)]]
    WORK_VAR @output = (LIST ())
    WORK_VAR @num = (start)
    WHILE (LESS(num, end)) {
        ADD_ELEM(output, num)
        SET num = (ADD(num, step))
    }
    RET (output)
}
PRINT(makeRange(5))
PRINT(makeRange(5, 7))
PRINT(makeRange(0, 10, 4))
>>> expectPrint
LIST (5, 6, 7)
LIST (5, 6)
LIST (0, 4, 8)
=========================
>>> testCase "Default value evaluated only when argument is omitted"
>>> setupFile ~/targetPackage/main.petrol
PREP_FUNC @getDefault {
    PRINT("Evaluating default value")
    RET (LIST ())
}
PREP_FUNC @myFunc {
    [ARGS [@myList = (getDefault())]]
    ADD_ELEM(myList, 1)
    RET (myList)
}
PRINT(myFunc(LIST (0)))
PRINT(myFunc())
COMMENT "Each invocation evaluates the default value again."
PRINT(myFunc())
>>> expectPrint
LIST (0, 1)
Evaluating default value
LIST (1)
Evaluating default value
LIST (1)
