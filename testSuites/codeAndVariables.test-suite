>>> testCase "CLONE_CODE function with prepped workers"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @capturedCode = <MAP [FIELDS []]>
COMMENT "Stores the invocation statement in `capturedCode` without prepping child workers."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @nameComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            SET_MEMBER(capturedCode, MEMBER(nameComp, #STR), worker)
        })
    ]])
]]>
PREP_VAR @tryClone = <FUNC {
    [ARGS [@code]]
    TRY {
        CLONE_CODE(code)
        PRINT("Cloned")
    } CATCH {
        [EXCEP @excep]
        PRINT(MEMBER(excep, #ERROR_TYPE))
        PRINT(MEMBER(excep, #MESSAGE))
    }
}>
capture "myStmt" (10) [FOO (20)] [BAR (30)]
WORK_VAR @stmt = (MEMBER(capturedCode, "myStmt"))
WORK_VAR @comps = (MEMBER(stmt, #COMPS))
WORK_VAR @exprsComp = (MEMBER(comps, 2))
WORK_VAR @fooAttrsComp = (MEMBER(comps, 3))
WORK_VAR @barAttrsComp = (MEMBER(comps, 4))
WORK_VAR @fooAttr = (MEMBER(MEMBER(fooAttrsComp, #ATTRS), 0))
WORK_VAR @barAttr = (MEMBER(MEMBER(barAttrsComp, #ATTRS), 0))
COMMENT "The statement is in work-phase, but child workers are in prep-phase."
tryClone(stmt)
tryClone(exprsComp)
tryClone(fooAttrsComp)
tryClone(fooAttr)
CALL_METHOD(exprsComp, #PREP)
CALL_METHOD(MEMBER(MEMBER(barAttr, #COMPS), 1), #PREP)
tryClone(exprsComp)
tryClone(fooAttrsComp)
tryClone(fooAttr)
tryClone(barAttrsComp)
tryClone(barAttr)
