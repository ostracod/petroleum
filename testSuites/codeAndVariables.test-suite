>>> testCase "NEW_FRAME function"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @capturedCode = <MAP [FIELDS []]>
COMMENT "Stores the invocation statement in `capturedCode` without prepping child workers."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @nameComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            SET_MEMBER(capturedCode, MEMBER(nameComp, #STR), worker)
        })
    ]])
]]>
COMMENT "Returns the frame passed to the #EVAL method."
PREP_VAR @currentFrame = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#EVAL) = (FUNC {
            [ARGS [@worker, @frame]]
            RET (frame)
        })
    ]])
]]>
capture "myStmt" {
    WORK_VAR @var1 = (10)
    WORK_VAR @var2
    PREP_VAR @var3 = <30>
    PRINT(var2)
}
WORK_VAR @stmtsComp = (MEMBER(MEMBER(MEMBER(capturedCode, "myStmt"), #COMPS), 2))
CALL_METHOD(stmtsComp, #PREP)
WORK_VAR @scope = (SCOPE(stmtsComp))
WORK_VAR @parentFrame = (currentFrame ())
WORK_VAR @frame = (NEW_FRAME(scope, parentFrame))
PRINT(MEMBER(frame, #IS_FRAME))
PRINT(EQUAL(MEMBER(frame, #SCOPE), scope))
PRINT(EQUAL(MEMBER(frame, #PARENT), parentFrame))
WORK_VAR @frameEntries = (MEMBER(frame, #FRAME_ENTRIES))
PRINT(LEN(frameEntries))
WORK_VAR @frameEntry1 = (MEMBER(frameEntries, "var1"))
PRINT(MEMBER(frameEntry1, #IS_FRAME_ENTRY))
PRINT(EQUAL(MEMBER(frameEntry1, #VAR), FIND_VAR(scope, "var1")))
PRINT(MEMBER(frameEntry1, #VALUE))
PRINT(HAS_KEY(frameEntries, "var2"))
PRINT(HAS_KEY(frameEntries, "var3"))
SET_MEMBER(MEMBER(frameEntries, "var2"), #VALUE, 20)
CALL_METHOD(stmtsComp, #EVAL, LIST(frame))
PRINT(MEMBER(frameEntry1, #VALUE))
WORK_VAR @orphanFrame = (NEW_FRAME(scope, NULL))
PRINT(HAS_KEY(orphanFrame, #PARENT))
PRINT(EQUAL(MEMBER(MEMBER(orphanFrame, #FRAME_ENTRIES), "var1"), frameEntry1))
