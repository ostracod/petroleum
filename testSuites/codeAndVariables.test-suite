>>> testCase "CLONE_CODE function in procedure"
>>> setupFile ~/targetPackage/main.petrol
PREP_SYMBOL @#stmtsComps
COMMENT "Evaluates the statement sequence twice using a copy."
PREP_VAR @twice = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @stmtsComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            WORK_VAR @stmtsCopy = (CLONE_CODE(stmtsComp))
            CALL_METHOD(stmtsComp, #PREP)
            CALL_METHOD(stmtsCopy, #PREP)
            SET_MEMBER(worker, #stmtsComps, LIST(stmtsComp, stmtsCopy))
        })
        (#EVAL) = (FUNC {
            [ARGS [@worker, @frame]]
            WORK_VAR @stmtsComps = (MEMBER(worker, #stmtsComps))
            CALL_METHOD(MEMBER(stmtsComps, 0), #EVAL, LIST(frame))
            CALL_METHOD(MEMBER(stmtsComps, 1), #EVAL, LIST(frame))
        })
    ]])
]]>
WORK_VAR @count = (0)
twice {
    WORK_VAR @message = ("Count: ")
    SET count = (ADD(count, 1))
    PRINT(CONCAT(LIST(message, STR(count))))
}
PRINT(count)
