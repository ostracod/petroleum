>>> testCase "SCOPE function"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @capturedCode = <MAP [FIELDS []]>
COMMENT "Stores the invocation statement in `capturedCode` without prepping child workers."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @nameComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            SET_MEMBER(capturedCode, MEMBER(nameComp, #STR), worker)
        })
    ]])
]]>
capture "topStmt"
RUN {
    capture "runStmt" (ADD(1, 2))
}
capture "blockStmt" {
    PRINT("Hello")
}
WORK_VAR @moduleScope = (SCOPE(MEMBER(capturedCode, "topStmt")))
PRINT(MEMBER(moduleScope, #IS_SCOPE))
PRINT(MEMBER(MEMBER(moduleScope, #MODULE), #FILE_PATH))
WORK_VAR @runStmt = (MEMBER(capturedCode, "runStmt"))
WORK_VAR @runScope = (SCOPE(runStmt))
PRINT(EQUAL(runScope, moduleScope))
PRINT(EQUAL(MEMBER(runScope, #PARENT), moduleScope))
WORK_VAR @exprsComp = (MEMBER(MEMBER(runStmt, #COMPS), 2))
PRINT(EQUAL(SCOPE(exprsComp), runScope))
PRINT(EQUAL(SCOPE(MEMBER(MEMBER(exprsComp, #EXPRS), 0)), runScope))
WORK_VAR @stmtsComp = (MEMBER(MEMBER(MEMBER(capturedCode, "blockStmt"), #COMPS), 2))
WORK_VAR @blockScope = (SCOPE(stmtsComp))
PRINT(EQUAL(MEMBER(blockScope, #STMTS_COMP), stmtsComp))
PRINT(EQUAL(MEMBER(blockScope, #PARENT), moduleScope))
PRINT(EQUAL(SCOPE(MEMBER(MEMBER(stmtsComp, #STMTS), 0)), blockScope))
