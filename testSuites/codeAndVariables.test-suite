>>> testCase "FIND_VAR function"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @capturedCode = <MAP [FIELDS []]>
COMMENT "Stores the invocation statement in `capturedCode` without prepping child workers."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @nameComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            SET_MEMBER(capturedCode, MEMBER(nameComp, #STR), worker)
        })
    ]])
]]>
PREP_VAR @shadowedVar = <10>
WORK_VAR @topVar = (20)
RUN {
    WORK_VAR @shadowedVar = (30)
    PREP_VAR @runVar = <40>
    capture "runStmt"
}
WORK_VAR @runScope = (SCOPE(MEMBER(capturedCode, "runStmt")))
WORK_VAR @moduleScope = (MEMBER(runScope, #PARENT))
WORK_VAR @var = (FIND_VAR(runScope, "runVar"))
PRINT(MEMBER(var, #IDENT))
PRINT(MEMBER(var, #VAR_TYPE))
PRINT(MEMBER(var, #VALUE))
PRINT(EQUAL(MEMBER(var, #SCOPE), runScope))
SET var = (FIND_VAR(runScope, "topVar"))
PRINT(MEMBER(var, #VAR_TYPE))
PRINT(EQUAL(MEMBER(var, #SCOPE), moduleScope))
SET var = (FIND_VAR(runScope, "shadowedVar"))
PRINT(MEMBER(var, #VAR_TYPE))
PRINT(EQUAL(MEMBER(var, #SCOPE), runScope))
SET var = (FIND_VAR(moduleScope, "shadowedVar"))
PRINT(MEMBER(var, #VAR_TYPE))
PRINT(MEMBER(var, #VALUE))
SET var = (FIND_VAR(runScope, "ADD"))
PRINT(EQUAL(MEMBER(var, #VALUE), ADD))
PRINT(HAS_KEY(MEMBER(var, #SCOPE), #PARENT))
PRINT(FIND_VAR(runScope, "missingVar"))
PRINT(FIND_VAR(moduleScope, "runVar"))
