>>> testCase "EVAL method of statement sequence component"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @capturedCode = <MAP [FIELDS []]>
COMMENT "Stores the invocation statement in `capturedCode` without prepping child workers."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @nameComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            SET_MEMBER(capturedCode, MEMBER(nameComp, #STR), worker)
        })
    ]])
]]>
PREP_VAR @preppedNames = <MAP [FIELDS []]>
PREP_VAR @evalVarSpaces = <MAP [FIELDS []]>
COMMENT "Records the name of each prepped worker and the variable space of each evaluation."
PREP_VAR @tracked = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @name = (MEMBER(MEMBER(MEMBER(worker, #COMPS), 1), #STR))
            SET_MEMBER(preppedNames, name, TRUE)
        })
        (#EVAL) = (FUNC {
            [ARGS [@worker, @varSpace]]
            WORK_VAR @name = (MEMBER(MEMBER(MEMBER(worker, #COMPS), 1), #STR))
            PRINT(CONCAT(LIST ("Evaluating ", name)))
            SET_MEMBER(evalVarSpaces, name, varSpace)
            RET (CONCAT(LIST ("Result ", name)))
        })
    ]])
]]>
PREP_VAR @currentFrame = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#EVAL) = (FUNC {
            [ARGS [@worker, @frame]]
            RET (frame)
        })
    ]])
]]>
capture "myStmt" {
    tracked "a"
    WORK_VAR @myVar = (5)
    tracked "b"
}
WORK_VAR @captureStmt = (MEMBER(capturedCode, "myStmt"))
WORK_VAR @stmtsComp = (MEMBER(MEMBER(captureStmt, #COMPS), 2))
WORK_VAR @outerFrame = (currentFrame ())
PRINT(CALL_METHOD(stmtsComp, #EVAL, LIST (outerFrame)))
WORK_VAR @frame = (MEMBER(evalVarSpaces, "a"))
PRINT(MEMBER(frame, #IS_FRAME))
PRINT(EQUAL(frame, outerFrame))
PRINT(EQUAL(MEMBER(frame, #SCOPE), SCOPE(stmtsComp)))
PRINT(EQUAL(MEMBER(frame, #PARENT), outerFrame))
PRINT(EQUAL(MEMBER(evalVarSpaces, "b"), frame))
PRINT(MEMBER(MEMBER(MEMBER(frame, #FRAME_ENTRIES), "myVar"), #VALUE))
COMMENT "Each evaluation creates a new frame."
CALL_METHOD(stmtsComp, #EVAL, LIST (outerFrame))
PRINT(EQUAL(MEMBER(evalVarSpaces, "a"), frame))
COMMENT "When the variable space is a scope, the new frame has no parent."
CALL_METHOD(stmtsComp, #EVAL, LIST (SCOPE(captureStmt)))
SET frame = (MEMBER(evalVarSpaces, "a"))
PRINT(EQUAL(MEMBER(frame, #SCOPE), SCOPE(stmtsComp)))
PRINT(HAS_KEY(frame, #PARENT))
