>>> testCase "PREP method of built-in workers enters work-phase"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @capturedCode = <MAP [FIELDS []]>
COMMENT "Stores the invocation statement in `capturedCode` without prepping child workers."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @nameComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            SET_MEMBER(capturedCode, MEMBER(nameComp, #STR), worker)
        })
    ]])
]]>
capture "myStmt" (ADD(1, 2), "text")
WORK_VAR @exprsComp = (MEMBER(MEMBER(MEMBER(capturedCode, "myStmt"), #COMPS), 2))
WORK_VAR @exprs = (MEMBER(exprsComp, #EXPRS))
WORK_VAR @invocExpr = (MEMBER(exprs, 0))
WORK_VAR @argsComp = (MEMBER(MEMBER(invocExpr, #COMPS), 1))
WORK_VAR @phases = (FUNC {
    RET (LIST (
        MEMBER(exprsComp, #PHASE)
        MEMBER(invocExpr, #PHASE)
        MEMBER(argsComp, #PHASE)
        MEMBER(MEMBER(MEMBER(argsComp, #EXPRS), 0), #PHASE)
        MEMBER(MEMBER(exprs, 1), #PHASE)
    ))
})
PRINT(CALL(phases))
CALL_METHOD(exprsComp, #PREP)
PRINT(CALL(phases))
