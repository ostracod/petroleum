WORK_VAR @stmt = (MEMBER(MEMBER(stmtsComp, #STMTS), 0))
PRINT(MEMBER(stmt, #PHASE))
PRINT(MEMBER(stmt, #INVOC))
PRINT(CALL_METHOD(stmt, #PREP))
PRINT(MEMBER(stmt, #PHASE))
PRINT(EQUAL(MEMBER(stmt, #INVOC), tracked))
COMMENT "The #PREP method does not run again."
CALL_METHOD(stmt, #PREP)
PRINT(MEMBER(stmtsComp, #PHASE))
CALL_METHOD(stmtsComp, #PREP)
PRINT(MEMBER(stmtsComp, #PHASE))
