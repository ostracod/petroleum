>>> testCase "EVAL method of statement sequence component"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode, @tracked, @evalVarSpaces, @currentFrame]]
capture "myStmt" {
    tracked "a"
    WORK_VAR @myVar = (5)
    tracked "b"
}
WORK_VAR @captureStmt = (MEMBER(capturedCode, "myStmt"))
WORK_VAR @stmtsComp = (MEMBER(MEMBER(captureStmt, #COMPS), 2))
WORK_VAR @outerFrame = (currentFrame ())
PRINT(CALL_METHOD(stmtsComp, #EVAL, LIST (outerFrame)))
WORK_VAR @frame = (MEMBER(evalVarSpaces, "a"))
PRINT(MEMBER(frame, #IS_FRAME))
PRINT(EQUAL(frame, outerFrame))
PRINT(EQUAL(MEMBER(frame, #SCOPE), SCOPE(stmtsComp)))
PRINT(EQUAL(MEMBER(frame, #PARENT), outerFrame))
PRINT(EQUAL(MEMBER(evalVarSpaces, "b"), frame))
PRINT(MEMBER(MEMBER(MEMBER(frame, #FRAME_ENTRIES), "myVar"), #VALUE))
COMMENT "Each evaluation creates a new frame."
CALL_METHOD(stmtsComp, #EVAL, LIST (outerFrame))
PRINT(EQUAL(MEMBER(evalVarSpaces, "a"), frame))
COMMENT "When the variable space is a scope, the new frame has no parent."
CALL_METHOD(stmtsComp, #EVAL, LIST (SCOPE(captureStmt)))
SET frame = (MEMBER(evalVarSpaces, "a"))
PRINT(EQUAL(MEMBER(frame, #SCOPE), SCOPE(stmtsComp)))
PRINT(HAS_KEY(frame, #PARENT))
>>> expectPrint
