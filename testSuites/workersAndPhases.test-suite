>>> commonFile ~/targetPackage/testUtils.petrol
PREP_VAR @capturedCode = <MAP [FIELDS []]>
COMMENT "Usage: capture \"name\" $comps"
COMMENT "Stores the invocation statement in `capturedCode` without prepping child workers."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @nameComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            SET_MEMBER(capturedCode, MEMBER(nameComp, #STR), worker)
        })
    ]])
]]>
COMMENT "Usage: currentFrame ()"
COMMENT "Returns the frame passed to the #EVAL method."
PREP_VAR @currentFrame = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#EVAL) = (FUNC {
            [ARGS [@worker, @frame]]
            RET (frame)
        })
    ]])
]]>
PREP_VAR @getName = <FUNC {
    [ARGS [@worker]]
    RET (MEMBER(MEMBER(MEMBER(worker, #COMPS), 1), #STR))
}>
PREP_VAR @describe = <FUNC {
    [ARGS [@action, @worker]]
    RET (CONCAT(LIST (action, " ", getName(worker), " in ", STR(MEMBER(worker, #PHASE)))))
}>
COMMENT "Map from tracked worker name to the variable space passed to its #EVAL method."
PREP_VAR @evalVarSpaces = <MAP [FIELDS []]>
COMMENT "Usage: tracked \"name\""
COMMENT "Prints whenever one of its methods is invoked."
COMMENT "The #EVAL method returns \"Result $name\"."
PREP_VAR @tracked = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            PRINT(describe("Prepping", worker))
        })
        (#EVAL) = (FUNC {
            [ARGS [@worker, @varSpace]]
            PRINT(describe("Evaluating", worker))
            SET_MEMBER(evalVarSpaces, getName(worker), varSpace)
            RET (CONCAT(LIST ("Result ", getName(worker))))
        })
        (#ACCESSED_VARS) = (FUNC {
            [ARGS [@worker, @scope]]
            PRINT(describe("Getting accessed vars of", worker))
            RET (MAP [FIELDS []])
        })
    ]])
]]>
COMMENT "Map from slow worker name to TRUE when the worker may finish prepping."
PREP_VAR @slowReleases = <MAP [FIELDS []]>
COMMENT "Usage: slow \"name\""
COMMENT "The #PREP method spins until `name` is a key in `slowReleases`."
PREP_VAR @slow = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @name = (getName(worker))
            PRINT(CONCAT(LIST ("Started prepping ", name)))
            SPIN (FUNC {
                RET (HAS_KEY(slowReleases, name))
            }, CONCAT(LIST ("Waiting for release of ", name)))
            PRINT(CONCAT(LIST ("Finished prepping ", name)))
        })
    ]])
]]>
COMMENT "Usage: evalInPrep $comp"
COMMENT "The #PREP method evaluates the component and prints the result."
PREP_VAR @evalInPrep = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @comp = (MEMBER(MEMBER(worker, #COMPS), 1))
            PRINT(CALL_METHOD(comp, #EVAL, LIST (SCOPE(worker))))
        })
    ]])
]]>
COMMENT "Usage: evalInWork $comp"
COMMENT "The #EVAL method evaluates the component and prints the result."
PREP_VAR @evalInWork = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#EVAL) = (FUNC {
            [ARGS [@worker, @varSpace]]
            WORK_VAR @comp = (MEMBER(MEMBER(worker, #COMPS), 1))
            PRINT(CALL_METHOD(comp, #EVAL, LIST (varSpace)))
        })
    ]])
]]>
=========================
>>> testCase "PREP method enters work-phase"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode, @tracked]]
capture "myStmt" {
    tracked "a"
}
WORK_VAR @stmtsComp = (MEMBER(MEMBER(MEMBER(capturedCode, "myStmt"), #COMPS), 2))
WORK_VAR @stmt = (MEMBER(MEMBER(stmtsComp, #STMTS), 0))
PRINT(MEMBER(stmt, #PHASE))
PRINT(MEMBER(stmt, #INVOC))
PRINT(CALL_METHOD(stmt, #PREP))
PRINT(MEMBER(stmt, #PHASE))
PRINT(EQUAL(MEMBER(stmt, #INVOC), tracked))
COMMENT "The #PREP method does not run again."
CALL_METHOD(stmt, #PREP)
PRINT(MEMBER(stmtsComp, #PHASE))
CALL_METHOD(stmtsComp, #PREP)
PRINT(MEMBER(stmtsComp, #PHASE))
>>> expectPrint
#PREP_PHASE
NULL
Prepping a in #PREP_PHASE
NULL
#WORK_PHASE
1
#PREP_PHASE
#WORK_PHASE
=========================
>>> testCase "PREP method of built-in workers enters work-phase"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode]]
capture "myStmt" (ADD(1, 2), "text")
WORK_VAR @exprsComp = (MEMBER(MEMBER(MEMBER(capturedCode, "myStmt"), #COMPS), 2))
WORK_VAR @exprs = (MEMBER(exprsComp, #EXPRS))
WORK_VAR @invocExpr = (MEMBER(exprs, 0))
WORK_VAR @argsComp = (MEMBER(MEMBER(invocExpr, #COMPS), 1))
WORK_VAR @phases = (FUNC {
    RET (LIST (
        MEMBER(exprsComp, #PHASE)
        MEMBER(invocExpr, #PHASE)
        MEMBER(argsComp, #PHASE)
        MEMBER(MEMBER(MEMBER(argsComp, #EXPRS), 0), #PHASE)
        MEMBER(MEMBER(exprs, 1), #PHASE)
    ))
})
PRINT(CALL(phases))
CALL_METHOD(exprsComp, #PREP)
PRINT(CALL(phases))
>>> expectPrint
