>>> testCase "PREP method only runs once with concurrent invocations"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @capturedCode = <MAP [FIELDS []]>
COMMENT "Stores the invocation statement in `capturedCode` without prepping child workers."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @nameComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            SET_MEMBER(capturedCode, MEMBER(nameComp, #STR), worker)
        })
    ]])
]]>
PREP_VAR @prepState = <MAP [FIELDS [
    ("canFinish") = (FALSE)
    ("prepCount") = (0)
]]>
COMMENT "The #PREP method waits until `canFinish` is true."
PREP_VAR @slowPrep = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            SET_MEMBER(prepState, "prepCount", ADD(MEMBER(prepState, "prepCount"), 1))
            PRINT("Prep started")
            SPIN (FUNC {
                RET (MEMBER(prepState, "canFinish"))
            }, "Waiting for canFinish")
            PRINT("Prep finished")
        })
    ]])
]]>
capture "myStmt" {
    slowPrep
}
WORK_VAR @stmtsComp = (MEMBER(MEMBER(MEMBER(capturedCode, "myStmt"), #COMPS), 2))
WORK_VAR @stmt = (MEMBER(MEMBER(stmtsComp, #STMTS), 0))
SCHED {
    PRINT("Second invocation started")
    PRINT(MEMBER(stmt, #PHASE))
    SET_MEMBER(prepState, "canFinish", TRUE)
    CALL_METHOD(stmt, #PREP)
    PRINT("Second invocation finished")
    PRINT(MEMBER(stmt, #PHASE))
    PRINT(MEMBER(prepState, "prepCount"))
}
CALL_METHOD(stmt, #PREP)
PRINT("First invocation finished")
>>> expectPrint
Prep started
Second invocation started
#PREP_PHASE
Prep finished
First invocation finished
Second invocation finished
#WORK_PHASE
1
=========================
>>> testCase "PREP method of expression sequence component"
>>> setupFile ~/targetPackage/main.petrol
PREP_VAR @capturedCode = <MAP [FIELDS []]>
COMMENT "Stores the invocation statement in `capturedCode` without prepping child workers."
PREP_VAR @capture = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @nameComp = (MEMBER(MEMBER(worker, #COMPS), 1))
            SET_MEMBER(capturedCode, MEMBER(nameComp, #STR), worker)
        })
    ]])
]]>
PREP_VAR @preppedNames = <MAP [FIELDS []]>
PREP_VAR @evalVarSpaces = <MAP [FIELDS []]>
COMMENT "Records the name of each prepped worker and the variable space of each evaluation."
PREP_VAR @tracked = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            WORK_VAR @name = (MEMBER(MEMBER(MEMBER(worker, #COMPS), 1), #STR))
            SET_MEMBER(preppedNames, name, TRUE)
        })
        (#EVAL) = (FUNC {
            [ARGS [@worker, @varSpace]]
            WORK_VAR @name = (MEMBER(MEMBER(MEMBER(worker, #COMPS), 1), #STR))
            PRINT(CONCAT(LIST ("Evaluating ", name)))
            SET_MEMBER(evalVarSpaces, name, varSpace)
            RET (CONCAT(LIST ("Result ", name)))
        })
    ]])
]]>
PREP_VAR @prepState = <MAP [FIELDS [("canFinish") = (FALSE)]]>
COMMENT "The #PREP method waits until `canFinish` is true."
PREP_VAR @slow = <MAP [FIELDS [
    (#IS_PROC) = (TRUE)
    (#METHODS) = (MAP [FIELDS [
        (#PREP) = (FUNC {
            [ARGS [@worker]]
            SPIN (FUNC {
                RET (MEMBER(prepState, "canFinish"))
            }, "Waiting for canFinish")
        })
    ]])
]]>
capture "myStmt" (tracked "a", slow "b", tracked "c")
WORK_VAR @exprsComp = (MEMBER(MEMBER(MEMBER(capturedCode, "myStmt"), #COMPS), 2))
WORK_VAR @exprs = (MEMBER(exprsComp, #EXPRS))
SCHED {
    PRINT(MEMBER(exprsComp, #PHASE))
    PRINT(MEMBER(MEMBER(exprs, 1), #PHASE))
    SET_MEMBER(prepState, "canFinish", TRUE)
}
PRINT(LEN(preppedNames))
CALL_METHOD(exprsComp, #PREP)
PRINT(LEN(preppedNames))
PRINT(HAS_KEY(preppedNames, "a"))
PRINT(HAS_KEY(preppedNames, "c"))
PRINT(MEMBER(exprsComp, #PHASE))
PRINT(MEMBER(MEMBER(exprs, 0), #PHASE))
PRINT(MEMBER(MEMBER(exprs, 1), #PHASE))
PRINT(MEMBER(MEMBER(exprs, 2), #PHASE))
