>>> testCase "PREP method of expression sequence component"
>>> setupFile ~/targetPackage/main.petrol
IMPORT <"./testUtils.petrol"> [VARS [@capture, @capturedCode, @tracked, @slow, @slowReleases]]
capture "myStmt" (tracked "a", slow "b", tracked "c")
WORK_VAR @exprsComp = (MEMBER(MEMBER(MEMBER(capturedCode, "myStmt"), #COMPS), 2))
WORK_VAR @exprs = (MEMBER(exprsComp, #EXPRS))
WORK_VAR @phases = (FUNC {
    RET (LIST (
        MEMBER(exprsComp, #PHASE)
        MEMBER(MEMBER(exprs, 0), #PHASE)
        MEMBER(MEMBER(exprs, 1), #PHASE)
        MEMBER(MEMBER(exprs, 2), #PHASE)
    ))
})
SCHED {
    SPIN (FUNC {
        RET (EQUAL(MEMBER(MEMBER(exprs, 2), #PHASE), #WORK_PHASE))
    }, "Waiting for c to enter work-phase")
    PRINT(CALL(phases))
    SET_MEMBER(slowReleases, "b", TRUE)
}
CALL_METHOD(exprsComp, #PREP)
PRINT(CALL(phases))
